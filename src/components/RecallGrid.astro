---
/**
 * What the recall number costs, drawn as robots.
 *
 * The bar chart next to this says 95.5% and 58.6%. Those read as similar
 * numbers. Drawn as a hundred robots they are not: one chart is a rounding
 * error, the other is four robots in ten missing from the match record.
 *
 * Every figure here comes from data/model.ts, which comes from the project's
 * own training artifacts. Nothing is illustrative.
 */
import { detector, pct } from "../data/model";

const CELLS = 100;

/** Deterministic scatter so misses look distributed, not clustered at the end. */
function missedSet(recall: number) {
  const missCount = CELLS - Math.round(recall * CELLS);
  const set = new Set<number>();
  // Golden-ratio stride spreads picks evenly without a PRNG or a clumped tail.
  let i = 0;
  const stride = 0.61803398875;
  let cursor = 0.5;
  while (set.size < missCount && i < 1000) {
    cursor = (cursor + stride) % 1;
    set.add(Math.floor(cursor * CELLS));
    i += 1;
  }
  return set;
}

const views = [
  {
    id: "val",
    label: "Validation split",
    sub: "Frames from the same pool it trained on",
    recall: detector.v1.precision && detector.v1.recall,
    precision: detector.v1.precision,
    missed: missedSet(detector.v1.recall),
    found: Math.round(detector.v1.recall * CELLS),
  },
  {
    id: "holdout",
    label: `Held-out event · ${detector.holdoutEvent}`,
    sub: "An event the model had never seen",
    recall: detector.v2.recall,
    precision: detector.v2.precision,
    missed: missedSet(detector.v2.recall),
    found: Math.round(detector.v2.recall * CELLS),
  },
];
---

<figure class="rg" data-recall-grid>
  <div class="rg-head">
    <div>
      <p class="mono">Fig. 04 · One hundred robots</p>
      <p class="rg-sub">
        Same detector, two datasets. Each square is a robot that was actually on
        the field.
      </p>
    </div>
    <div class="seg" role="group" aria-label="Choose an evaluation set">
      {views.map((v, i) => (
        <button
          type="button"
          class:list={["chip", { "is-on": i === 0 }]}
          data-view={v.id}
          aria-pressed={i === 0 ? "true" : "false"}
        >
          {i === 0 ? "Validation" : "Held-out event"}
        </button>
      ))}
    </div>
  </div>

  <div class="rg-body">
    {views.map((v, vi) => (
      <div
        class:list={["view", { "is-on": vi === 0 }]}
        data-panel={v.id}
        aria-hidden={vi === 0 ? "false" : "true"}
      >
        <div class="grid" role="img" aria-label={`${v.found} of 100 robots detected, ${CELLS - v.found} missed, on the ${v.label}.`}>
          {Array.from({ length: CELLS }, (_, i) => (
            <span
              class:list={["cell", { miss: v.missed.has(i) }]}
              style={`--d:${(i % 10) * 12 + Math.floor(i / 10) * 18}ms`}
            ></span>
          ))}
        </div>

        <div class="readout">
          <p class="mono rg-label">{v.label}</p>
          <p class="rg-note">{v.sub}</p>

          <p class="big">
            <strong>{v.found}</strong> found
            <span class="sep">/</span>
            <strong class="miss-n">{CELLS - v.found}</strong> missed
          </p>

          <dl class="rg-stats">
            <div>
              <dt class="mono">Recall</dt>
              <dd>{pct(vi === 0 ? detector.v1.recall : detector.v2.recall)}</dd>
            </div>
            <div>
              <dt class="mono">Precision</dt>
              <dd>{pct(v.precision)}</dd>
            </div>
          </dl>

          <p class="rg-mean">
            {vi === 0
              ? "On data that looks like training data, a miss is a rounding error. This is the number that makes a model look finished."
              : "On an event it has never seen, four robots in ten never make it into the match record. A missed robot is an uncounted cycle, and a strategy call made on a number that is quietly wrong."}
          </p>
        </div>
      </div>
    ))}
  </div>

  <figcaption>
    Both figures are the detector's own evaluation output: v1 on its validation
    split, v2 on {detector.holdoutImages} frames from {detector.holdoutEvent} that
    were held out of training. Precision stays high in both, which matters — what
    it does report is usually real. Recall is what falls over, and recall is what
    a scouting record depends on.
  </figcaption>
</figure>

<style>
  .rg {
    margin: 2.25rem 0;
    border: 1px solid var(--rule-2);
    background: var(--paper-2);
  }

  .rg-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .rg-sub { margin: 0.25rem 0 0; font-size: 0.84rem; color: var(--ink-3); max-width: 46ch; }

  .seg { display: flex; gap: 0.3rem; }

  .chip {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--rule-2);
    background: transparent;
    color: var(--ink-3);
    cursor: pointer;
    border-radius: 2px;
    white-space: nowrap;
  }

  .chip:hover { color: var(--ink); }

  .chip.is-on {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .rg-body { display: grid; }

  .view {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: 17rem minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.2rem);
    align-items: start;
    padding: 1.1rem 1rem 1.2rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.22s ease, visibility 0.22s;
  }

  .view.is-on { opacity: 1; visibility: visible; }

  .grid {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 4px;
    width: 100%;
  }

  .cell {
    aspect-ratio: 1;
    background: var(--accent);
    border-radius: 1px;
    transition: background 0.3s ease;
    transition-delay: var(--d);
  }

  /* A miss is drawn as absence, not as a different colour: the square is
     empty because the robot is not in the record. */
  .cell.miss {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--rule-2);
  }

  .readout { min-width: 0; }

  .rg-note { margin: 0.2rem 0 0; font-size: 0.82rem; color: var(--ink-3); }

  .big {
    margin: 0.9rem 0 0;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    color: var(--ink-2);
  }

  .big strong { color: var(--accent); font-weight: 600; }
  .big .miss-n { color: var(--flag); }
  .big .sep { color: var(--ink-3); margin: 0 0.4rem; }

  .rg-stats { display: flex; gap: 1.8rem; margin: 0.9rem 0 0; }

  .rg-stats dt {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .rg-stats dd { margin: 0.15rem 0 0; font-size: 1rem; font-weight: 600; }

  .rg-mean {
    margin: 1rem 0 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 46ch;
  }

  figcaption {
    padding: 0.8rem 1rem 0.95rem;
    border-top: 1px solid var(--rule);
    font-size: 0.82rem;
    color: var(--ink-3);
    line-height: 1.55;
  }

  @media (max-width: 700px) {
    .view { grid-template-columns: 1fr; }
    .grid { max-width: 15rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cell { transition: none; transition-delay: 0ms; }
  }
</style>

<script>
  const host = document.querySelector<HTMLElement>("[data-recall-grid]");

  if (host) {
    const btns = Array.from(host.querySelectorAll<HTMLButtonElement>("[data-view]"));
    const panels = Array.from(host.querySelectorAll<HTMLElement>("[data-panel]"));

    btns.forEach((b) => {
      b.addEventListener("click", () => {
        const id = b.dataset.view!;
        btns.forEach((x) => {
          const on = x === b;
          x.classList.toggle("is-on", on);
          x.setAttribute("aria-pressed", String(on));
        });
        panels.forEach((p) => {
          const on = p.dataset.panel === id;
          p.classList.toggle("is-on", on);
          p.setAttribute("aria-hidden", String(!on));
        });
      });
    });
  }
</script>
