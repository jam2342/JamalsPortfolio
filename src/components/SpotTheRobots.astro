---
/**
 * "Spot the robots": find every robot in a real match frame against a timer,
 * then compare with the labels v2 learned from and with what v4 detects.
 *
 * The point is felt rather than read: a person finds all six, the old labels
 * boxed three or four, and a model taught on those labels learns that the rest
 * are background. Every frame and box comes from data/spotRobots.ts, which
 * comes from the project's own datasets and the shipped v4 model.
 *
 * Works by pointer and by keyboard (arrows move a crosshair, Enter marks),
 * respects reduced motion, and needs no server.
 */
import { spotFrames } from "../data/spotRobots";

const SECONDS = 20;
const total = spotFrames.reduce((n, f) => n + f.robots.length, 0);
const labelTotal = spotFrames.reduce((n, f) => n + f.robots.filter((r) => r.label).length, 0);
const v4Total = spotFrames.reduce((n, f) => n + f.robots.filter((r) => r.v4).length, 0);
const pos = (b: readonly number[]) =>
  `left:${b[0]}%;top:${b[1]}%;width:${b[2]}%;height:${b[3]}%`;
---

<figure
  class="spot"
  data-spot
  data-seconds={SECONDS}
  data-total={total}
  data-label-total={labelTotal}
  data-v4-total={v4Total}
>
  <div class="spot-head">
    <div>
      <p class="mono">Fig. 05 · Spot the robots</p>
      <p class="spot-sub">
        Real match frames, {SECONDS} seconds each. Tap every robot you can find.
      </p>
    </div>
    <p class="mono spot-count" data-count>Frame 1 of {spotFrames.length}</p>
  </div>

  <div class="spot-scroll">
    <div class="spot-stage">
      {
        spotFrames.map((f, fi) => (
          <div
            class:list={["frame", { "is-on": fi === 0 }]}
            data-frame={fi}
            style={`aspect-ratio:${f.width} / ${f.height}`}
            aria-hidden={fi === 0 ? "false" : "true"}
          >
            <img
              src={f.src}
              alt={`A broadcast frame from ${f.event}, looking down the length of the field from behind the drivers.`}
              width={f.width}
              height={f.height}
              loading="lazy"
              decoding="async"
              draggable="false"
            />
            <div class="layer truth" aria-hidden="true">
              {f.robots.map((r, ri) => (
                <span
                  class="rb"
                  data-robot={ri}
                  data-label={r.label ? "1" : "0"}
                  data-v4={r.v4 ? "1" : "0"}
                  data-box={r.box.join(",")}
                  style={pos(r.box)}
                />
              ))}
              {f.v4Extra.map((b) => (
                <span class="rb extra" style={pos(b)} />
              ))}
            </div>
            <div class="layer taps" data-taps aria-hidden="true" />
          </div>
        ))
      }

      <div
        class="hit"
        data-hit
        tabindex="0"
        role="application"
        aria-label="Match frame. Use the arrow keys to move the crosshair and Enter to mark a robot. Hold Shift for smaller steps."
        aria-describedby="spot-status"
      >
        <span class="cross" data-cross hidden></span>
      </div>

      <div class="gate" data-gate>
        <button type="button" class="btn" data-start>Start · {SECONDS} s</button>
      </div>
    </div>
  </div>
  <p class="mono spot-pan" aria-hidden="true">Drag sideways to see the whole field</p>

  <div class="spot-bar">
    <div class="timer" aria-hidden="true">
      <span class="timer-fill" data-fill></span>
    </div>
    <p class="mono timer-n" data-clock aria-hidden="true">{SECONDS}.0 s</p>
    <p class="mono marks" data-marks aria-hidden="true">0 marked</p>
    <button type="button" class="chip" data-done disabled>Done</button>
  </div>

  <p class="sr-only" id="spot-status" aria-live="polite" data-status></p>

  <div class="reveal-panel" data-reveal hidden>
    <div class="views" role="group" aria-label="Compare">
      <button type="button" class="chip is-on" data-show="you" aria-pressed="true">You</button>
      <button type="button" class="chip" data-show="label" aria-pressed="false">Training labels</button>
      <button type="button" class="chip" data-show="v4" aria-pressed="false">v4</button>
    </div>

    <dl class="tally">
      <div><dt class="mono">You</dt><dd data-tally-you>–</dd></div>
      <div><dt class="mono">Training labels</dt><dd data-tally-labels>–</dd></div>
      <div><dt class="mono">v4</dt><dd data-tally-v4>–</dd></div>
    </dl>

    <p class="legend" data-legend></p>
    <p class="punch" data-punch></p>

    <div class="next-row">
      <button type="button" class="btn" data-next>Next frame</button>
      <button type="button" class="chip" data-again hidden>Play again</button>
    </div>
  </div>

  <figcaption>
    Frames from two 2026 Texas district events, cropped below the broadcast
    scoreboard. "Training labels" are the boxes v2 was trained on. v4 was not
    trained on any of these frames, and none of them come from the locked
    holdout. v4 runs at its shipped cutoff; a dotted box is something it called a
    robot that isn't one.
  </figcaption>
</figure>

<style>
  .spot {
    margin: 2.25rem 0;
    border: 1px solid var(--rule-2);
    background: var(--paper-2);
  }

  .spot-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .spot-sub { margin: 0.25rem 0 0; font-size: 0.84rem; color: var(--ink-3); max-width: 48ch; }
  .spot-count { margin: 0; color: var(--ink-3); }

  /* Below ~760px the robots get too small to tap, so the frame keeps a
     minimum width and the strip scrolls sideways instead of shrinking. */
  .spot-scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .spot-stage {
    position: relative;
    min-width: 720px;
    display: grid;
  }

  .frame {
    grid-area: 1 / 1;
    position: relative;
    visibility: hidden;
  }

  .frame.is-on { visibility: visible; }

  .frame img {
    display: block;
    width: 100%;
    height: 100%;
    user-select: none;
    -webkit-user-select: none;
    transition: filter 0.25s ease;
  }

  .spot[data-phase="ready"] .frame img { filter: blur(10px) saturate(0.6); }

  .layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .rb {
    position: absolute;
    display: none;
    box-sizing: border-box;
  }

  /* After the reveal, each view decides which robots read as found. */
  .spot[data-phase="reveal"] .rb:not(.extra) { display: block; }

  .rb.found {
    border: 2px solid var(--spot-hit);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.55);
  }

  .rb.missed {
    border: 2px dashed var(--spot-miss);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.55);
    background: rgba(255, 140, 40, 0.14);
  }

  .spot[data-view="v4"] .rb.extra {
    display: block;
    border: 2px dotted #ffffff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.7);
  }

  .spot :global(.tap) {
    position: absolute;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    border-radius: 50%;
    border: 2px solid #ffffff;
    background: rgba(27, 30, 28, 0.55);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.6);
    color: #ffffff;
    font: 600 0.6rem/18px var(--mono);
    text-align: center;
  }

  .spot[data-view="you"] :global(.tap.ok) { background: var(--spot-hit); border-color: #ffffff; }
  .spot[data-view="you"] :global(.tap.no) { background: var(--spot-miss); border-color: #ffffff; }
  .spot[data-phase="reveal"]:not([data-view="you"]) :global(.tap) { display: none; }

  .spot [hidden] { display: none !important; }

  .hit {
    position: absolute;
    inset: 0;
    cursor: crosshair;
    outline: none;
    touch-action: manipulation;
  }

  .hit:focus-visible { box-shadow: inset 0 0 0 3px var(--accent); }
  .spot:not([data-phase="play"]) .hit { cursor: default; }

  .cross {
    position: absolute;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    pointer-events: none;
    background:
      linear-gradient(#fff, #fff) center / 2px 100% no-repeat,
      linear-gradient(#fff, #fff) center / 100% 2px no-repeat;
    filter: drop-shadow(0 0 1px #000) drop-shadow(0 0 1px #000);
  }

  .gate {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .spot:not([data-phase="ready"]) .gate { display: none; }

  .spot-pan {
    display: none;
    margin: 0;
    padding: 0.45rem 1rem 0;
    color: var(--ink-3);
    font-size: 0.6rem;
  }

  @media (max-width: 760px) {
    .spot-pan { display: block; }
  }

  .spot-bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--rule);
  }

  .timer {
    flex: 1;
    height: 6px;
    background: var(--rule);
    border-radius: 1px;
    overflow: hidden;
  }

  .timer-fill {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--accent);
    transform-origin: left;
  }

  .timer-fill.low { background: var(--flag); }

  .timer-n, .marks {
    margin: 0;
    font-size: 0.66rem;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .chip {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--rule-2);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    border-radius: 2px;
    white-space: nowrap;
  }

  .chip:hover:not(:disabled) { color: var(--ink); }
  .chip:disabled { opacity: 0.45; cursor: default; }

  .chip.is-on {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .reveal-panel {
    padding: 1rem;
    border-top: 1px solid var(--rule);
  }

  .views { display: flex; flex-wrap: wrap; gap: 0.3rem; }

  .tally {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
    margin: 1rem 0 0;
  }

  .tally dt {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .tally dd {
    margin: 0.15rem 0 0;
    font-size: 1.2rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .legend {
    margin: 0.8rem 0 0;
    font-size: 0.84rem;
    color: var(--ink-3);
    max-width: 62ch;
  }

  .punch {
    margin: 0.8rem 0 0;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--ink);
    max-width: 58ch;
  }

  .next-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  figcaption {
    padding: 0.8rem 1rem 0.95rem;
    border-top: 1px solid var(--rule);
    font-size: 0.82rem;
    color: var(--ink-3);
    line-height: 1.55;
  }

  /* Box colours sit on a photo, not on the page, so they stay bright in both
     themes rather than following the page tokens. */
  .spot {
    --spot-hit: #2fbf71;
    --spot-miss: #ff8a1f;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .frame img { transition: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-spot]");

  if (root) {
    const SECONDS = Number(root.dataset.seconds);
    const frames = Array.from(root.querySelectorAll<HTMLElement>("[data-frame]"));
    const hit = root.querySelector<HTMLElement>("[data-hit]")!;
    const cross = root.querySelector<HTMLElement>("[data-cross]")!;
    const startBtn = root.querySelector<HTMLButtonElement>("[data-start]")!;
    const doneBtn = root.querySelector<HTMLButtonElement>("[data-done]")!;
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-next]")!;
    const againBtn = root.querySelector<HTMLButtonElement>("[data-again]")!;
    const fill = root.querySelector<HTMLElement>("[data-fill]")!;
    const clock = root.querySelector<HTMLElement>("[data-clock]")!;
    const marksEl = root.querySelector<HTMLElement>("[data-marks]")!;
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const reveal = root.querySelector<HTMLElement>("[data-reveal]")!;
    const views = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-show]"));
    const youEl = root.querySelector<HTMLElement>("[data-tally-you]")!;
    const labelsEl = root.querySelector<HTMLElement>("[data-tally-labels]")!;
    const v4El = root.querySelector<HTMLElement>("[data-tally-v4]")!;
    const legend = root.querySelector<HTMLElement>("[data-legend]")!;
    const punch = root.querySelector<HTMLElement>("[data-punch]")!;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    type Tap = { x: number; y: number; el: HTMLElement; robot: number | null };

    let index = 0;
    let taps: Tap[] = [];
    let found = new Set<number>();
    let deadline = 0;
    let raf = 0;
    let warned = false;
    let cursor = { x: 50, y: 50 };
    const totals = { you: 0, label: 0, v4: 0, robots: 0 };

    const frame = () => frames[index];
    const robots = () => Array.from(frame().querySelectorAll<HTMLElement>(".rb:not(.extra)"));

    function setPhase(p: "ready" | "play" | "reveal") {
      root!.dataset.phase = p;
      hit.setAttribute("aria-disabled", String(p !== "play"));
      hit.tabIndex = p === "play" ? 0 : -1;
      doneBtn.disabled = p !== "play";
      reveal.hidden = p !== "reveal";
    }

    function paintClock(left: number) {
      clock.textContent = `${left.toFixed(1)} s`;
      fill.style.transform = `scaleX(${left / SECONDS})`;
      fill.classList.toggle("low", left <= 5);
    }

    function tick() {
      const left = Math.max(0, (deadline - performance.now()) / 1000);
      paintClock(left);
      if (!warned && left <= 5) {
        warned = true;
        status.textContent = "5 seconds left.";
      }
      if (left <= 0) return finish(true);
      raf = requestAnimationFrame(tick);
    }

    function start() {
      setPhase("play");
      deadline = performance.now() + SECONDS * 1000;
      warned = false;
      status.textContent = `Go. ${SECONDS} seconds. Mark every robot you can see.`;
      // With reduced motion the bar still moves, but only in whole-second steps.
      if (reduced) {
        const step = () => {
          const left = Math.max(0, Math.ceil((deadline - performance.now()) / 1000));
          paintClock(left);
          if (!warned && left <= 5) { warned = true; status.textContent = "5 seconds left."; }
          if (left <= 0) return finish(true);
          raf = window.setTimeout(step, 250) as unknown as number;
        };
        step();
      } else {
        raf = requestAnimationFrame(tick);
      }
      hit.focus({ preventScroll: true });
    }

    function stopClock() {
      cancelAnimationFrame(raf);
      clearTimeout(raf);
    }

    // Percent coordinates in, nearest unclaimed robot (with a small margin) out.
    function robotAt(x: number, y: number, exclude: Set<number>) {
      const f = frame();
      const img = f.querySelector("img")!;
      const w = Number(img.getAttribute("width"));
      const h = Number(img.getAttribute("height"));
      const mx = (10 / w) * 100;
      const my = (10 / h) * 100;
      let best: number | null = null;
      let bestD = Infinity;
      robots().forEach((r, i) => {
        if (exclude.has(i)) return;
        const [l, t, bw, bh] = r.dataset.box!.split(",").map(Number);
        if (x < l - mx || x > l + bw + mx || y < t - my || y > t + bh + my) return;
        const cx = ((x - (l + bw / 2)) / 100) * w;
        const cy = ((y - (t + bh / 2)) / 100) * h;
        const d = cx * cx + cy * cy;
        if (d < bestD) { bestD = d; best = i; }
      });
      return best;
    }

    function updateMarks() {
      marksEl.textContent = `${taps.length} marked`;
    }

    function mark(x: number, y: number) {
      if (root!.dataset.phase !== "play") return;
      const layer = frame().querySelector<HTMLElement>("[data-taps]")!;
      // Tapping an existing mark removes it, so a slip is easy to undo.
      const near = taps.findIndex((t) => Math.abs(t.x - x) < 1.2 && Math.abs(t.y - y) < 4);
      if (near >= 0) {
        taps[near].el.remove();
        taps.splice(near, 1);
        taps.forEach((t, i) => (t.el.textContent = String(i + 1)));
        updateMarks();
        status.textContent = `Mark removed. ${taps.length} marked.`;
        return;
      }
      const el = document.createElement("span");
      el.className = "tap";
      el.style.left = `${x}%`;
      el.style.top = `${y}%`;
      el.textContent = String(taps.length + 1);
      layer.appendChild(el);
      taps.push({ x, y, el, robot: null });
      updateMarks();
      status.textContent = `${taps.length} marked.`;
    }

    function finish(timedOut: boolean) {
      if (root!.dataset.phase !== "play") return;
      stopClock();
      cross.hidden = true;

      found = new Set<number>();
      taps.forEach((t) => {
        t.robot = robotAt(t.x, t.y, found);
        if (t.robot !== null) found.add(t.robot);
        t.el.classList.add(t.robot !== null ? "ok" : "no");
      });

      const rs = robots();
      const n = rs.length;
      const labelled = rs.filter((r) => r.dataset.label === "1").length;
      const v4 = rs.filter((r) => r.dataset.v4 === "1").length;
      const extra = frame().querySelectorAll(".rb.extra").length;
      const wrong = taps.filter((t) => t.robot === null).length;

      totals.you += found.size;
      totals.label += labelled;
      totals.v4 += v4;
      totals.robots += n;

      youEl.textContent = `${found.size} of ${n}`;
      labelsEl.textContent = `${labelled} of ${n}`;
      v4El.textContent = `${v4} of ${n}`;

      const youLine = found.size === n ? `You found all ${n}.` : `You found ${found.size} of ${n}.`;
      punch.textContent = `${youLine} The labels v2 learned from boxed ${labelled}. Every robot left unboxed was taught as background. That's why v2 missed about four robots in ten on an event it had never seen.`;
      root!.dataset.wrong = String(wrong);
      root!.dataset.extra = String(extra);

      const last = index === frames.length - 1;
      nextBtn.textContent = last ? "See your total" : "Next frame";

      setPhase("reveal");
      show("you");
      status.textContent = `${timedOut ? "Time." : "Done."} ${youLine} The training labels boxed ${labelled}. v4 found ${v4}.`;
      nextBtn.focus({ preventScroll: true });
    }

    function show(view: "you" | "label" | "v4") {
      root!.dataset.view = view;
      views.forEach((b) => {
        const on = b.dataset.show === view;
        b.classList.toggle("is-on", on);
        b.setAttribute("aria-pressed", String(on));
      });
      robots().forEach((r, i) => {
        const ok =
          view === "you" ? found.has(i) : view === "label" ? r.dataset.label === "1" : r.dataset.v4 === "1";
        r.classList.toggle("found", ok);
        r.classList.toggle("missed", !ok);
      });
      const wrong = Number(root!.dataset.wrong || 0);
      const extra = Number(root!.dataset.extra || 0);
      legend.textContent =
        view === "you"
          ? `Solid boxes are robots you marked; dashed ones you missed.${wrong ? ` ${wrong} of your marks hit no robot.` : ""}`
          : view === "label"
            ? "Solid boxes were in the training labels. Dashed ones were never boxed, so the model was taught they were background."
            : `Solid boxes are robots v4 detected at its shipped cutoff; dashed ones it missed.${extra ? ` The dotted box is a detection that isn't a robot.` : ""}`;
    }

    function load(i: number) {
      frames.forEach((f, fi) => {
        const on = fi === i;
        f.classList.toggle("is-on", on);
        f.setAttribute("aria-hidden", String(!on));
        f.querySelector<HTMLElement>("[data-taps]")!.replaceChildren();
        f.querySelectorAll(".rb").forEach((r) => r.classList.remove("found", "missed"));
      });
      index = i;
      taps = [];
      found = new Set();
      cursor = { x: 50, y: 50 };
      updateMarks();
      paintClock(SECONDS);
      count.textContent = `Frame ${i + 1} of ${frames.length}`;
      setPhase("ready");
      // Warm the next image so it's there when asked for.
      const next = frames[i + 1]?.querySelector("img");
      if (next) next.loading = "eager";
    }

    function summary() {
      count.textContent = "All frames";
      youEl.textContent = `${totals.you} of ${totals.robots}`;
      labelsEl.textContent = `${totals.label} of ${totals.robots}`;
      v4El.textContent = `${totals.v4} of ${totals.robots}`;
      legend.textContent = "Totals across every frame.";
      punch.textContent = `You ${totals.you}/${totals.robots} · training labels ${totals.label}/${totals.robots} · v4 ${totals.v4}/${totals.robots}. Over the locked holdout, v4's recall is 68%, up from 51% for v2 measured the same way.`;
      nextBtn.hidden = true;
      againBtn.hidden = false;
      views.forEach((b) => (b.hidden = true));
      status.textContent = punch.textContent;
      againBtn.focus({ preventScroll: true });
    }

    hit.addEventListener("click", (e) => {
      if (root!.dataset.phase !== "play") return;
      const r = hit.getBoundingClientRect();
      mark(((e.clientX - r.left) / r.width) * 100, ((e.clientY - r.top) / r.height) * 100);
    });

    hit.addEventListener("keydown", (e) => {
      if (root!.dataset.phase !== "play") return;
      const step = e.shiftKey ? 0.5 : 2;
      const ratio = hit.clientWidth / Math.max(1, hit.clientHeight);
      const moves: Record<string, [number, number]> = {
        ArrowLeft: [-step, 0],
        ArrowRight: [step, 0],
        ArrowUp: [0, -step * ratio],
        ArrowDown: [0, step * ratio],
      };
      if (moves[e.key]) {
        e.preventDefault();
        cursor.x = Math.min(100, Math.max(0, cursor.x + moves[e.key][0]));
        cursor.y = Math.min(100, Math.max(0, cursor.y + moves[e.key][1]));
        cross.hidden = false;
        cross.style.left = `${cursor.x}%`;
        cross.style.top = `${cursor.y}%`;
      } else if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        cross.hidden = false;
        cross.style.left = `${cursor.x}%`;
        cross.style.top = `${cursor.y}%`;
        mark(cursor.x, cursor.y);
      } else if (e.key === "Escape") {
        finish(false);
      }
    });

    startBtn.addEventListener("click", start);
    doneBtn.addEventListener("click", () => finish(false));
    views.forEach((b) => b.addEventListener("click", () => show(b.dataset.show as "you" | "label" | "v4")));
    nextBtn.addEventListener("click", () => {
      if (index < frames.length - 1) {
        load(index + 1);
        startBtn.focus({ preventScroll: true });
      } else {
        summary();
      }
    });
    againBtn.addEventListener("click", () => {
      totals.you = totals.label = totals.v4 = totals.robots = 0;
      nextBtn.hidden = false;
      againBtn.hidden = true;
      views.forEach((b) => (b.hidden = false));
      load(0);
      startBtn.focus({ preventScroll: true });
    });

    load(0);
  }
</script>
