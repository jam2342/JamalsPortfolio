---
interface EvidenceItem {
  value: string;
  label: string;
  detail?: string;
}

interface Props {
  items: EvidenceItem[];
  label?: string;
}

const { items, label = "Evidence at a glance" } = Astro.props;
---

<section class="evidence" aria-label={label}>
  <dl>
    {
      items.map((item) => (
        <div class="evidence-item reveal">
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
          {item.detail && <p>{item.detail}</p>}
        </div>
      ))
    }
  </dl>
</section>

<style>
  .evidence {
    border-block: 1px solid var(--rule);
  }

  .evidence dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .evidence-item {
    min-width: 0;
    padding: 1.25rem 1.15rem 1.3rem 0;
  }

  .evidence-item + .evidence-item {
    border-left: 1px solid var(--rule);
    padding-left: 1.15rem;
  }

  dt {
    font-family: var(--mono);
    font-size: var(--fs-label);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  dd {
    margin: 0.45rem 0 0;
    font-size: clamp(1.25rem, 2.3vw, 1.7rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  p {
    margin: 0.5rem 0 0;
    color: var(--ink-3);
    font-size: var(--fs-sm);
    line-height: 1.45;
  }

  @media (max-width: 760px) {
    .evidence dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .evidence-item:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }

    .evidence-item:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
  }

  @media (max-width: 430px) {
    .evidence dl {
      grid-template-columns: 1fr;
    }

    .evidence-item,
    .evidence-item + .evidence-item {
      border-left: 0;
      border-top: 1px solid var(--rule);
      padding-left: 0;
    }

    .evidence-item:first-child {
      border-top: 0;
    }
  }
</style>
