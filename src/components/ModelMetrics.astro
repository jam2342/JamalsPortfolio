---
import { detector, pct } from "../data/model";

/**
 * Detector evaluation, drawn as bars. Separate panels rather than one chart
 * because v1's number answers a different question from the held-out ones and
 * should not be read as part of a trend line.
 */

const rows = [
  { key: "map50", label: "mAP@50" },
  { key: "map5095", label: "mAP@50-95" },
  { key: "precision", label: "Precision" },
  { key: "recall", label: "Recall" },
] as const;

const panels = [
  {
    head: "v1 · validation split · 80 epochs, A100",
    sub: "Frames drawn from the same pool the model trained on.",
    data: detector.v1,
    holdout: false,
  },
  {
    head: `v2 · held-out event · ${detector.holdoutEvent}`,
    sub: "An event the model never saw. The honest number, and the old bar.",
    data: detector.v2,
    holdout: true,
  },
  {
    head: `v4 · same held-out event · current`,
    sub: "Trained only on frames with near-complete labels. Runs on phones.",
    data: detector.v4,
    holdout: true,
  },
];
---

<div class="metrics">
  {
    panels.map((p) => (
      <div class="metrics-panel">
        <p class="mono panel-head">{p.head}</p>
        <p class="panel-sub">{p.sub}</p>
        {rows.map((r) => (
          <div class="bar-row">
            <span class="bar-label mono">{r.label}</span>
            <div class="bar-track">
              <div class:list={["bar-fill", { "is-holdout": p.holdout }]} style={`--w:${p.data[r.key] * 100}%`} />
            </div>
            <span class="bar-val mono">{pct(p.data[r.key])}</span>
          </div>
        ))}
      </div>
    ))
  }
</div>

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    margin: 2.25rem 0 1rem;
    overflow: hidden;
  }

  .metrics-panel {
    background: var(--paper-2);
    padding: 1.1rem;
  }

  .panel-head {
    margin: 0 0 0.3rem;
    color: var(--ink-2);
  }

  .panel-sub {
    margin: 0 0 1.1rem;
    font-size: 0.84rem;
    color: var(--ink-3);
    line-height: 1.45;
    min-height: 2.4em;
  }

  .bar-row {
    display: grid;
    grid-template-columns: 5.6rem 1fr 3.1rem;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.62rem;
  }

  .bar-label {
    font-size: 0.63rem;
  }

  .bar-track {
    height: 6px;
    background: var(--rule);
    border-radius: 1px;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    width: 0;
    background: var(--accent);
    border-radius: 1px;
    /* Grows once the figure scrolls into view. */
    transition: width 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .bar-fill.is-holdout {
    background: var(--flag);
  }

  .metrics.in .bar-fill {
    width: var(--w);
  }

  .bar-val {
    font-size: 0.68rem;
    text-align: right;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .bar-fill {
      width: var(--w);
      transition: none;
    }
  }

  @media (max-width: 860px) {
    .metrics {
      grid-template-columns: 1fr;
    }

    .panel-sub {
      min-height: 0;
    }
  }
</style>

<script>
  const el = document.querySelector(".metrics");
  if (el) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      el.classList.add("in");
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.25 }
      );
      io.observe(el);
    }
  }
</script>
