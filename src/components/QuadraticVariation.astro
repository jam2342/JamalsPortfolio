---
/**
 * Why Itô's formula carries a second-order term.
 *
 * A Brownian path is refined step by step. Two running sums are tracked:
 * the sum of |ΔW| (which diverges) and the sum of (ΔW)² (which converges to
 * the elapsed time). That second fact is the reason (dW)² = dt survives into
 * the chain rule while (dt)² does not.
 *
 * Everything is computed live from a seeded path.
 */
---

<figure class="qv" data-qv>
  <div class="qv-head">
    <p class="mono">Fig. 03 &mdash; Quadratic variation of a Brownian path</p>
    <div class="qv-controls">
      <label class="qv-slider">
        <span class="mono">Steps</span>
        <input type="range" min="3" max="12" value="5" step="1" data-steps
          aria-label="Number of refinement steps, as a power of two" />
        <span class="mono qv-n" data-n>32</span>
      </label>
      <button type="button" class="chip chip-alt" data-newpath>New path</button>
    </div>
  </div>

  <canvas data-canvas width="880" height="300" role="img"
    aria-label="A Brownian sample path subdivided into increments, with each increment drawn as a vertical step."></canvas>

  <div class="qv-sums">
    <div class="sum">
      <p class="mono sum-label">&Sigma; |&Delta;W|</p>
      <p class="sum-val" data-abs>0.00</p>
      <p class="sum-note">Grows without bound as the partition refines.</p>
    </div>
    <div class="sum is-key">
      <p class="mono sum-label">&Sigma; (&Delta;W)&sup2;</p>
      <p class="sum-val" data-sq>0.00</p>
      <p class="sum-note">Settles on the elapsed time, t = 1.</p>
    </div>
    <div class="sum">
      <p class="mono sum-label">&Sigma; (&Delta;t)&sup2;</p>
      <p class="sum-val" data-dt2>0.00</p>
      <p class="sum-note">Vanishes. This is why ordinary calculus drops it.</p>
    </div>
  </div>

  <figcaption>
    Drag the slider to subdivide the same path more finely. The absolute
    variation runs away and the squared variation converges to 1, no matter
    which path you draw. That limit is the content of (dW)&sup2; = dt, and it is
    the term ordinary calculus has no reason to keep.
  </figcaption>
</figure>

<script>
  const HOST = document.querySelector<HTMLElement>("[data-qv]");

  if (HOST) {
    const canvas = HOST.querySelector<HTMLCanvasElement>("[data-canvas]")!;
    const ctx = canvas.getContext("2d")!;
    const slider = HOST.querySelector<HTMLInputElement>("[data-steps]")!;
    const nOut = HOST.querySelector<HTMLElement>("[data-n]")!;
    const absOut = HOST.querySelector<HTMLElement>("[data-abs]")!;
    const sqOut = HOST.querySelector<HTMLElement>("[data-sq]")!;
    const dt2Out = HOST.querySelector<HTMLElement>("[data-dt2]")!;

    const W = 880;
    const H = 300;
    const PAD = { l: 40, r: 16, t: 18, b: 26 };

    // The finest resolution we ever sample; coarser partitions subsample this
    // same path, so refining shows the *same* walk in more detail.
    const FINE = 4096;

    let seed = 8675309;
    let path: number[] = [];

    function rng(s: number) {
      return function () {
        s |= 0;
        s = (s + 0x6d2b79f5) | 0;
        let t = Math.imul(s ^ (s >>> 15), 1 | s);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    function gauss(r: () => number) {
      let u = 0;
      let v = 0;
      while (u === 0) u = r();
      while (v === 0) v = r();
      return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
    }

    function buildPath(s: number) {
      const r = rng(s);
      const dt = 1 / FINE;
      const out = new Array<number>(FINE + 1);
      out[0] = 0;
      for (let i = 1; i <= FINE; i++) {
        out[i] = out[i - 1] + gauss(r) * Math.sqrt(dt);
      }
      return out;
    }

    function css(name: string) {
      return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    }

    function draw() {
      const k = Number(slider.value);
      const n = 2 ** k;
      const stride = FINE / n;

      // Sample the fine path at the current partition.
      const pts: number[] = [];
      for (let i = 0; i <= n; i++) pts.push(path[i * stride]);

      let sAbs = 0;
      let sSq = 0;
      for (let i = 1; i <= n; i++) {
        const d = pts[i] - pts[i - 1];
        sAbs += Math.abs(d);
        sSq += d * d;
      }
      const dt = 1 / n;
      const sDt2 = n * dt * dt;

      nOut.textContent = String(n);
      absOut.textContent = sAbs.toFixed(2);
      sqOut.textContent = sSq.toFixed(3);
      dt2Out.textContent = sDt2.toFixed(4);

      // ---- render ----
      const accent = css("--accent");
      const rule = css("--rule");
      const rule2 = css("--rule-2");
      const dim = css("--ink-3");

      ctx.clearRect(0, 0, W, H);

      let lo = Math.min(...path);
      let hi = Math.max(...path);
      const pad = (hi - lo) * 0.12 || 1;
      lo -= pad;
      hi += pad;

      const pw = W - PAD.l - PAD.r;
      const ph = H - PAD.t - PAD.b;
      const X = (u: number) => PAD.l + u * pw;
      const Y = (v: number) => PAD.t + ph - ((v - lo) / (hi - lo)) * ph;

      // Zero line.
      ctx.strokeStyle = rule;
      ctx.lineWidth = 1;
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      ctx.moveTo(PAD.l, Y(0));
      ctx.lineTo(W - PAD.r, Y(0));
      ctx.stroke();
      ctx.setLineDash([]);

      ctx.fillStyle = dim;
      ctx.font = '10px ui-monospace, monospace';
      ctx.fillText("W = 0", 4, Y(0) + 3.5);

      // The underlying fine path, faint.
      ctx.strokeStyle = rule2;
      ctx.globalAlpha = 0.55;
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let i = 0; i <= FINE; i += 4) {
        const x = X(i / FINE);
        const y = Y(path[i]);
        i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.stroke();
      ctx.globalAlpha = 1;

      // Increment risers: each |ΔW| drawn as a vertical segment.
      ctx.strokeStyle = accent;
      ctx.globalAlpha = 0.4;
      ctx.lineWidth = Math.max(0.6, 5 - k * 0.35);
      for (let i = 1; i <= n; i++) {
        const x = X(i / n);
        ctx.beginPath();
        ctx.moveTo(x, Y(pts[i - 1]));
        ctx.lineTo(x, Y(pts[i]));
        ctx.stroke();
      }
      ctx.globalAlpha = 1;

      // The partition polyline itself.
      ctx.strokeStyle = accent;
      ctx.lineWidth = 1.7;
      ctx.beginPath();
      pts.forEach((v, i) => {
        const x = X(i / n);
        const y = Y(v);
        i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      });
      ctx.stroke();

      // Partition nodes, only while sparse enough to read.
      if (n <= 128) {
        ctx.fillStyle = accent;
        pts.forEach((v, i) => {
          ctx.beginPath();
          ctx.arc(X(i / n), Y(v), n <= 32 ? 2.6 : 1.6, 0, Math.PI * 2);
          ctx.fill();
        });
      }

      ctx.fillStyle = dim;
      ctx.fillText("t = 0", PAD.l, H - 8);
      ctx.fillText("t = 1", W - PAD.r - 26, H - 8);
    }

    path = buildPath(seed);
    draw();

    slider.addEventListener("input", draw);

    HOST.querySelector("[data-newpath]")?.addEventListener("click", () => {
      seed = (seed * 1664525 + 1013904223) >>> 0;
      path = buildPath(seed);
      draw();
    });

    new MutationObserver(draw).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  }
</script>

<style>
  .qv {
    margin: 2.5rem 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-2);
    overflow: hidden;
  }

  .qv-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .qv-head > .mono {
    margin: 0;
  }

  .qv-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }

  .qv-slider {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .qv-slider input {
    width: 130px;
    accent-color: var(--accent);
    /* A bare range input is only ~16px tall, which is under the touch minimum. */
    min-height: 32px;
  }

  .qv-n {
    min-width: 2.6rem;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .chip {
    font-family: var(--mono);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink-3);
    border-radius: var(--radius);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .chip:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .chip-alt {
    border-style: dashed;
  }

  .qv canvas {
    width: 100%;
    height: auto;
    aspect-ratio: 880 / 300;
    padding: 0.75rem 0.6rem 0;
  }

  .qv-sums {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1px;
    background: var(--rule);
    border-top: 1px solid var(--rule);
    margin-top: 0.6rem;
  }

  .sum {
    background: var(--paper-2);
    padding: 0.9rem 1rem 1rem;
  }

  .sum-label {
    margin: 0 0 0.35rem;
    font-size: var(--fs-label);
  }

  .sum-val {
    margin: 0 0 0.35rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    /* Numbers update as the slider moves; keep the change readable. */
    transition: color 0.2s ease;
  }

  .sum.is-key .sum-val {
    color: var(--accent);
  }

  .sum-note {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--ink-3);
    line-height: 1.45;
  }

  .qv figcaption {
    padding: 0.9rem 1rem 1.05rem;
    border-top: 1px solid var(--rule);
    font-size: var(--fs-sm);
    color: var(--ink-3);
    line-height: 1.55;
    max-width: 68ch;
  }
</style>
