---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  /** Small label printed above the image, e.g. "Plate 01". */
  label?: string;
  width: number;
  height: number;
  /** Renders narrower, floated into the margin on wide screens. */
  aside?: boolean;
}

const { src, alt, caption, label, width, height, aside = false } = Astro.props;
---

<figure class:list={["fig", "reveal", { "fig-aside": aside }]}>
  <div class="fig-frame">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
    />
  </div>
  {
    (label || caption) && (
      <figcaption>
        {label && <span class="mono fig-label">{label}</span>}
        {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .fig {
    margin: 2.25rem 0;
  }

  .fig-frame {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-2);
    line-height: 0;
  }

  .fig img {
    width: 100%;
    height: auto;
    /* Slight settling of contrast so photos sit with the palette. */
    filter: saturate(0.94);
  }

  figcaption {
    margin-top: 0.7rem;
    font-size: var(--fs-sm);
    color: var(--ink-3);
    line-height: 1.55;
    max-width: 62ch;
  }

  .fig-label {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--accent);
    font-size: var(--fs-label);
  }

  @media (min-width: 1100px) {
    .fig-aside {
      float: right;
      width: 20rem;
      margin: 0.4rem 0 1.5rem 2.5rem;
    }
  }
</style>
