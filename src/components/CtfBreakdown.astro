---
import type { Competition } from "../data/experience";

interface Props {
  comp: Competition;
}

const { comp } = Astro.props;
const total = comp.breakdown!.reduce((n, b) => n + b.total, 0);
const solved = comp.breakdown!.reduce((n, b) => n + b.solved, 0);
---

<div class="ctf">
  <div class="ctf-head">
    <div>
      <p class="mono ctf-kicker">{comp.year}</p>
      <h3 class="h-md">{comp.name}</h3>
    </div>
    <div class="ctf-rank">
      <p class="rank-val">{comp.result}</p>
      {comp.score && <p class="mono rank-score">{comp.score}</p>}
    </div>
  </div>

  <div class="ctf-grid">
    {
      comp.breakdown!.map((b) => (
        <div class="cat">
          <div class="cat-top">
            <span class="cat-name">{b.area}</span>
            <span class="mono cat-n">{b.solved}/{b.total}</span>
          </div>
          <div class="cat-track" role="img"
            aria-label={`${b.area}: ${b.solved} of ${b.total} solved`}>
            <div class="cat-fill" style={`--w:${(b.solved / b.total) * 100}%`} />
          </div>
        </div>
      ))
    }
  </div>

  <div class="ctf-mine">
    <div>
      <p class="mono mine-label">Solved by me</p>
      <p class="mine-val">60 of 70</p>
    </div>
    <div>
      <p class="mono mine-label">Points contributed</p>
      <p class="mine-val">13,500 / 14,500</p>
    </div>
    <div>
      <p class="mono mine-label">Challenges rated 300+</p>
      <p class="mine-val">22 of 22</p>
    </div>
  </div>

  <p class="ctf-foot">
    <span class="mono ctf-total">{solved}/{total} challenges</span>
    {comp.detail}
  </p>
</div>

<style>
  .ctf {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-2);
    padding: 1.3rem 1.25rem 1.4rem;
  }

  .ctf-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1.35rem;
    border-bottom: 1px solid var(--rule);
  }

  .ctf-kicker {
    margin: 0 0 0.4rem;
  }

  .ctf-rank {
    text-align: right;
  }

  .rank-val {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--accent);
  }

  .rank-score {
    margin: 0.3rem 0 0;
    font-size: var(--fs-label);
    text-transform: none;
    letter-spacing: 0.04em;
    color: var(--flag);
  }

  .ctf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.9rem 1.6rem;
  }

  .cat-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }

  .cat-name {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }

  .cat-n {
    font-size: var(--fs-label);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .cat-track {
    height: 4px;
    background: var(--rule);
    border-radius: 1px;
    overflow: hidden;
  }

  .cat-fill {
    height: 100%;
    width: var(--w);
    background: var(--accent);
    border-radius: 1px;
  }

  .ctf-mine {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
  }

  .mine-label {
    margin: 0 0 0.35rem;
    font-size: var(--fs-label);
  }

  .mine-val {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.018em;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }

  .ctf-foot {
    margin: 1.35rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
    font-size: var(--fs-ui);
    color: var(--ink-2);
    max-width: 68ch;
  }

  .ctf-total {
    display: inline-block;
    color: var(--ink);
    border: 1px solid var(--rule-2);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius);
    margin-right: 0.6rem;
    font-size: var(--fs-label);
  }

  @media (max-width: 560px) {
    .ctf-rank {
      text-align: left;
    }
  }
</style>
