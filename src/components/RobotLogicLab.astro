---
/** Sensor noise, median filtering, and threshold control for a beginner robot. */
---
<figure class="logic" data-logic-lab>
  <header class="logic-head">
    <div><p class="mono">Control loop · ultrasonic sensor</p><h3 class="h-sm">What should the robot do with noisy input?</h3></div>
    <button type="button" class="sample" data-sample>Take 5 readings</button>
  </header>
  <div class="logic-grid">
    <div class="world" data-world>
      <div class="bot" aria-hidden="true"><span>◉</span><i></i><i></i></div>
      <div class="rays" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="wall" aria-hidden="true"></div>
      <output class="decision" data-decision>FORWARD</output>
      <label class="world-slider mono">Actual distance
        <input type="range" min="8" max="70" value="38" data-distance />
        <output data-distance-out>38 cm</output>
      </label>
    </div>
    <div class="logic-panel">
      <div class="readings">
        <p class="mono">Raw readings</p><div data-readings><span>—</span><span>—</span><span>—</span><span>—</span><span>—</span></div>
      </div>
      <div class="calculation">
        <div><span class="mono">Single reading</span><strong data-raw>—</strong><small>jumps with noise</small></div>
        <div class="key"><span class="mono">Median of five</span><strong data-median>—</strong><small>rejects one bad echo</small></div>
      </div>
      <label class="threshold"><span class="mono">Stop threshold</span><input type="range" min="12" max="45" value="24" data-threshold /><output data-threshold-out>24 cm</output></label>
      <pre><code>distance = median(readings)
if distance &lt; <span data-code-threshold>24</span>:
    motors.stop()
else:
    motors.forward()</code></pre>
    </div>
  </div>
  <figcaption>Move the obstacle, choose a threshold, then sample. A single ultrasonic echo can be wrong; the median preserves the beginner-readable condition while making the robot less erratic.</figcaption>
</figure>
<script>
  const lab = document.querySelector<HTMLElement>("[data-logic-lab]");
  if (lab) {
    const distance = lab.querySelector<HTMLInputElement>("[data-distance]")!;
    const threshold = lab.querySelector<HTMLInputElement>("[data-threshold]")!;
    const readings = lab.querySelector<HTMLElement>("[data-readings]")!;
    const raw = lab.querySelector<HTMLElement>("[data-raw]")!;
    const median = lab.querySelector<HTMLElement>("[data-median]")!;
    const decision = lab.querySelector<HTMLOutputElement>("[data-decision]")!;
    const world = lab.querySelector<HTMLElement>("[data-world]")!;
    let lastMedian = Number(distance.value);
    function updateWorld() {
      const d = Number(distance.value), t = Number(threshold.value);
      lab.querySelector<HTMLOutputElement>("[data-distance-out]")!.textContent = `${d} cm`;
      lab.querySelector<HTMLOutputElement>("[data-threshold-out]")!.textContent = `${t} cm`;
      lab.querySelector<HTMLElement>("[data-code-threshold]")!.textContent = String(t);
      world.style.setProperty("--wall", `${18 + d}%`);
      const stop = lastMedian < t; decision.textContent = stop ? "STOP" : "FORWARD"; world.classList.toggle("is-stop", stop);
    }
    function sample() {
      const d = Number(distance.value);
      const values = Array.from({length:5},(_,i)=>Math.max(2,Math.round(d+(Math.random()-.5)*6+(i===3?(Math.random()<.5?18:-14):0))));
      lastMedian = [...values].sort((a,b)=>a-b)[2];
      readings.innerHTML = values.map((v,i)=>`<span class="${i===3?"outlier":""}">${v}</span>`).join("");
      raw.textContent = `${values[3]} cm`; median.textContent = `${lastMedian} cm`; updateWorld();
    }
    distance.addEventListener("input",()=>{lastMedian=Number(distance.value);updateWorld()}); threshold.addEventListener("input",updateWorld);
    lab.querySelector("[data-sample]")?.addEventListener("click",sample); updateWorld(); sample();
  }
</script>
<style>
  .logic{border:1px solid var(--rule);background:var(--paper-2);margin:2.25rem 0;border-radius:var(--radius)}.logic-head{display:flex;justify-content:space-between;align-items:end;gap:1rem;padding:1rem 1.1rem;border-bottom:1px solid var(--rule)}.logic-head .mono{margin:0 0 .25rem}.sample{font:inherit;font-size:var(--fs-label);padding:.45rem .7rem;color:var(--accent);border:1px solid var(--accent);background:transparent;cursor:pointer}
  .logic-grid{display:grid;grid-template-columns:1.05fr .95fr;min-height:22rem}.world{--wall:56%;position:relative;overflow:hidden;border-right:1px solid var(--rule);background:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:28px 28px}.bot{position:absolute;left:10%;top:40%;width:4.2rem;height:2.7rem;background:var(--accent);color:var(--on-accent);display:grid;place-items:center;border-radius:var(--radius);transition:transform .3s}.bot i{position:absolute;bottom:-7px;width:12px;height:12px;border-radius:50%;background:var(--ink)}.bot i:nth-child(2){left:5px}.bot i:nth-child(3){right:5px}.wall{position:absolute;left:var(--wall);top:18%;bottom:26%;width:7px;background:var(--ink);transition:left .2s}.rays span{position:absolute;left:calc(10% + 4.2rem);top:47%;width:calc(var(--wall) - 10% - 4.2rem);height:1px;background:var(--accent);transform-origin:left;opacity:.35}.rays span:first-child{transform:rotate(-6deg)}.rays span:last-child{transform:rotate(6deg)}.decision{position:absolute;left:10%;top:22%;font-family:var(--mono);font-size:var(--fs-label);color:var(--accent)}.is-stop .decision{color:var(--flag)}.is-stop .bot{background:var(--flag)}.world-slider{position:absolute;left:1rem;right:1rem;bottom:1rem;display:grid;grid-template-columns:auto 1fr auto;gap:.6rem;align-items:center;font-size:var(--fs-label)}.world-slider input,.threshold input{accent-color:var(--accent);width:100%}
  .logic-panel{padding:1rem}.readings p{margin:0 0 .5rem}.readings [data-readings]{display:grid;grid-template-columns:repeat(5,1fr);gap:.3rem}.readings span{padding:.5rem .2rem;text-align:center;border:1px solid var(--rule);font-family:var(--mono);font-size:var(--fs-label)}.readings .outlier{border-color:var(--flag);color:var(--flag)}.calculation{display:grid;grid-template-columns:1fr 1fr;margin:1rem 0;border-block:1px solid var(--rule)}.calculation>div{padding:.75rem}.calculation>div:first-child{border-right:1px solid var(--rule)}.calculation span,.calculation small{display:block}.calculation strong{display:block;font-size:1.35rem;color:var(--ink-3)}.calculation .key strong{color:var(--accent)}.calculation small{font-size:var(--fs-label);color:var(--ink-3)}.threshold{display:grid;grid-template-columns:auto 1fr auto;gap:.5rem;align-items:center;font-size:var(--fs-label)}pre{margin:1rem 0 0;padding:.75rem;background:var(--paper);border:1px solid var(--rule);font-family:var(--mono);font-size:var(--fs-label);line-height:1.55;overflow:auto}pre span{color:var(--accent)}.logic figcaption{padding:.85rem 1rem;border-top:1px solid var(--rule);font-size:var(--fs-sm);color:var(--ink-3)}
  @media(max-width:760px){.logic-head{align-items:start;flex-direction:column}.logic-grid{grid-template-columns:1fr}.world{min-height:18rem;border-right:0;border-bottom:1px solid var(--rule)}.threshold{grid-template-columns:1fr}.threshold output{text-align:left}}
  @media(prefers-reduced-motion:reduce){.bot,.wall{transition:none}}
</style>
