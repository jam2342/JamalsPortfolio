---
/**
 * Season log: a scrubbable strip on wide screens, a plain list on phones.
 *
 * The strip is one slider over the stops. Faint bars behind it are commits per
 * week. Weeks with more commits are drawn wider, otherwise the twenty days of
 * late September and October would crush a third of the stops into a few
 * pixels; the caption says so. The list underneath is the same content and is
 * what phones, screen readers on small screens and no-JS visitors get.
 */
import { stops, commitsPerWeek, weeksStart } from "../data/seasonLog";

const DAY = 86_400_000;
const start = Date.parse(weeksStart);
const widths = commitsPerWeek.map((c) => 1.6 + Math.sqrt(c));
const totalW = widths.reduce((a, b) => a + b, 0);
const lefts = widths.map((_, i) => widths.slice(0, i).reduce((a, b) => a + b, 0));
const maxC = Math.max(...commitsPerWeek);

/** Position (0–100) of a date on the warped week axis. */
function at(iso: string) {
  const days = (Date.parse(iso) - start) / DAY;
  const w = Math.min(commitsPerWeek.length - 1, Math.floor(days / 7));
  const within = (days - w * 7 + 0.5) / 7;
  return ((lefts[w] + within * widths[w]) / totalW) * 100;
}

// Stops a day apart would sit on top of each other, so nudge them to a minimum
// gap, keeping order and staying as close to their dates as the gap allows.
const GAP = 1.7;
const xs = stops.map((s) => at(s.date));
for (let i = 1; i < xs.length; i++) xs[i] = Math.max(xs[i], xs[i - 1] + GAP);
xs[xs.length - 1] = Math.min(xs[xs.length - 1], 99);
for (let i = xs.length - 2; i >= 0; i--) xs[i] = Math.min(xs[i], xs[i + 1] - GAP);
xs[0] = Math.max(xs[0], 0.6);
const placed = stops.map((s, i) => ({ ...s, x: xs[i] }));

const monthNames = ["Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct"];
const months = monthNames.map((m, i) => ({
  m,
  x: at(`2026-${String(i + 2).padStart(2, "0")}-01`),
}));
const first = placed[0];
---

<figure class="log" data-log>
  <div class="log-head">
    <p class="mono">Season log · February to October 2026</p>
    <p class="log-hint mono" aria-hidden="true">Drag, click, or use the arrow keys</p>
  </div>

  <div class="strip">
    <div
      class="track"
      data-track
      role="slider"
      tabindex="0"
      aria-label="Season log"
      aria-valuemin="1"
      aria-valuemax={placed.length}
      aria-valuenow="1"
      aria-valuetext={`${first.when}: ${first.title}`}
    >
      <div class="bars" aria-hidden="true">
        {
          commitsPerWeek.map((c, i) => (
            <span
              class="bar"
              style={`left:${(lefts[i] / totalW) * 100}%;width:${(widths[i] / totalW) * 100}%;height:${c ? 8 + (c / maxC) * 92 : 0}%`}
              title={`${c} commits`}
            />
          ))
        }
      </div>
      <div class="rail" aria-hidden="true"></div>
      <span class="needle" data-needle aria-hidden="true" style={`left:${first.x}%`}></span>
      {
        placed.map((s, i) => (
          <span
            class:list={["dot", { "is-on": i === 0, "has-stat": !!s.stat }]}
            data-dot={i}
            style={`left:${s.x}%`}
            aria-hidden="true"
          />
        ))
      }
    </div>
    <div class="months" aria-hidden="true">
      {months.map((m) => <span style={`left:${m.x}%`}>{m.m}</span>)}
    </div>

    <div class="card" aria-live="polite">
      <div class="card-text">
        <p class="mono card-when" data-when>{first.when}</p>
        <p class="card-title" data-title>{first.title}</p>
        <p class="card-body" data-text>{first.text}</p>
      </div>
      <p class="card-stat" data-stat>{first.stat ?? ""}</p>
    </div>

    <div class="steps">
      <button type="button" class="chip" data-step="-1" aria-label="Previous stop">← Prev</button>
      <span class="mono step-n" data-pos aria-hidden="true">1 / {placed.length}</span>
      <button type="button" class="chip" data-step="1" aria-label="Next stop">Next →</button>
    </div>
  </div>

  <ol class="list" role="list">
    {
      placed.map((s) => (
        <li>
          <p class="mono li-when">{s.when}</p>
          <p class="li-title">{s.title}</p>
          <p class="li-body">{s.text}</p>
          {s.stat && <p class="li-stat">{s.stat}</p>}
        </li>
      ))
    }
  </ol>

  <figcaption>
    Faint bars are commits per week across every branch of the FRCMOB repository.
    Busier weeks are drawn wider so their stops have room, and stops a day apart
    are spaced out slightly. Dates are from commits and merged pull requests.
  </figcaption>

  <script type="application/json" data-stops set:html={JSON.stringify(placed)} />
</figure>

<style>
  .log {
    margin: 2.25rem 0;
    border: 1px solid var(--rule-2);
    background: var(--paper-2);
  }

  .log-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .log-head p { margin: 0; }
  .log-hint { color: var(--ink-3); }

  .strip { padding: 1.4rem 1.25rem 1rem; }

  .track {
    position: relative;
    height: 96px;
    cursor: pointer;
    touch-action: pan-y;
    outline: none;
    border-radius: var(--radius);
  }

  .track:focus-visible { box-shadow: 0 0 0 2px var(--accent); }

  .bars { position: absolute; inset: 0 0 18px; }

  .bar {
    position: absolute;
    bottom: 0;
    background: var(--ink);
    opacity: 0.07;
    border-left: 1px solid var(--paper-2);
  }

  .rail {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 17px;
    height: 1px;
    background: var(--rule-2);
  }

  .dot {
    position: absolute;
    bottom: 13px;
    width: 9px;
    height: 9px;
    margin-left: -4.5px;
    border-radius: 50%;
    background: var(--paper-2);
    border: 1.5px solid var(--ink-3);
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .dot.has-stat { border-color: var(--accent); }

  .dot.is-on {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.5);
    z-index: 1;
  }

  .needle {
    position: absolute;
    top: 0;
    bottom: 17px;
    width: 1px;
    background: var(--accent);
  }

  .months {
    position: relative;
    height: 1.1rem;
    margin-top: -0.6rem;
  }

  .months span {
    position: absolute;
    transform: translateX(-2px);
    font-family: var(--mono);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  .card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: end;
    margin-top: 1.1rem;
    min-height: 7.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .card-when { margin: 0; color: var(--accent); }

  .card-title {
    margin: 0.35rem 0 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .card-body {
    margin: 0.35rem 0 0;
    color: var(--ink-2);
    font-size: var(--fs-ui);
    line-height: 1.55;
    max-width: 62ch;
  }

  .card-stat {
    margin: 0;
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .steps {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .step-n { font-size: var(--fs-label); color: var(--ink-3); }

  .chip {
    font-family: var(--mono);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--rule-2);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    border-radius: var(--radius);
  }

  .chip:hover:not(:disabled) { color: var(--ink); }
  .chip:disabled { opacity: 0.4; cursor: default; }

  /* Phones and no-JS: the list. */
  .list {
    list-style: none;
    margin: 0;
    padding: 1rem 1rem 0.4rem 1.6rem;
    display: none;
  }

  .list li {
    position: relative;
    padding: 0 0 1.1rem 1rem;
    border-left: 1px solid var(--rule-2);
  }

  .list li::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 0.2rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--paper-2);
    border: 1.5px solid var(--accent);
  }

  .list p { margin: 0; }
  .li-when { color: var(--accent); font-size: var(--fs-label); }
  .li-title { margin-top: 0.2rem !important; font-weight: 600; }
  .li-body { margin-top: 0.2rem !important; font-size: var(--fs-ui); color: var(--ink-2); line-height: 1.5; }
  .li-stat { margin-top: 0.3rem !important; font-weight: 600; font-variant-numeric: tabular-nums; }

  figcaption {
    padding: 0.8rem 1rem 0.95rem;
    border-top: 1px solid var(--rule);
    font-size: var(--fs-sm);
    color: var(--ink-3);
    line-height: 1.55;
  }

  .log:not(.js) .strip,
  .log:not(.js) .log-hint { display: none; }
  .log:not(.js) .list { display: block; }

  @media (max-width: 760px) {
    .strip, .log-hint { display: none; }
    .log .list { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot { transition: none; }
  }
</style>

<script>
  type Placed = { when: string; title: string; text: string; stat?: string; x: number };

  const root = document.querySelector<HTMLElement>("[data-log]");
  if (root) {
    root.classList.add("js");
    const stops: Placed[] = JSON.parse(root.querySelector("[data-stops]")!.textContent || "[]");
    const track = root.querySelector<HTMLElement>("[data-track]")!;
    const needle = root.querySelector<HTMLElement>("[data-needle]")!;
    const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-dot]"));
    const whenEl = root.querySelector<HTMLElement>("[data-when]")!;
    const titleEl = root.querySelector<HTMLElement>("[data-title]")!;
    const textEl = root.querySelector<HTMLElement>("[data-text]")!;
    const statEl = root.querySelector<HTMLElement>("[data-stat]")!;
    const posEl = root.querySelector<HTMLElement>("[data-pos]")!;
    const prev = root.querySelector<HTMLButtonElement>('[data-step="-1"]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-step="1"]')!;
    let current = 0;

    function select(i: number) {
      i = Math.max(0, Math.min(stops.length - 1, i));
      if (i === current && whenEl.textContent === stops[i].when) return;
      current = i;
      const s = stops[i];
      dots.forEach((d, k) => d.classList.toggle("is-on", k === i));
      needle.style.left = `${s.x}%`;
      whenEl.textContent = s.when;
      titleEl.textContent = s.title;
      textEl.textContent = s.text;
      statEl.textContent = s.stat ?? "";
      posEl.textContent = `${i + 1} / ${stops.length}`;
      prev.disabled = i === 0;
      next.disabled = i === stops.length - 1;
      track.setAttribute("aria-valuenow", String(i + 1));
      track.setAttribute("aria-valuetext", `${s.when}: ${s.title}`);
    }

    function nearest(clientX: number) {
      const r = track.getBoundingClientRect();
      const x = ((clientX - r.left) / r.width) * 100;
      let best = 0;
      stops.forEach((s, i) => {
        if (Math.abs(s.x - x) < Math.abs(stops[best].x - x)) best = i;
      });
      return best;
    }

    let dragging = false;
    track.addEventListener("pointerdown", (e) => {
      dragging = true;
      track.setPointerCapture(e.pointerId);
      select(nearest(e.clientX));
    });
    track.addEventListener("pointermove", (e) => {
      if (dragging) select(nearest(e.clientX));
    });
    const end = () => (dragging = false);
    track.addEventListener("pointerup", end);
    track.addEventListener("pointercancel", end);

    track.addEventListener("keydown", (e) => {
      const map: Record<string, number> = {
        ArrowRight: current + 1,
        ArrowUp: current + 1,
        ArrowLeft: current - 1,
        ArrowDown: current - 1,
        Home: 0,
        End: stops.length - 1,
        PageUp: current + 5,
        PageDown: current - 5,
      };
      if (e.key in map) {
        e.preventDefault();
        select(map[e.key]);
      }
    });

    prev.addEventListener("click", () => select(current - 1));
    next.addEventListener("click", () => select(current + 1));
    prev.disabled = true;
  }
</script>
