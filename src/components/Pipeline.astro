---
/**
 * Interactive stage diagram. Click or focus a stage to read what it does.
 * Used for the FRCMOB vision pipeline and the hardening run order.
 */

export type Stage = {
  n: string;
  title: string;
  detail: string;
  /** Optional short technical tail, e.g. a parameter or file-level note. */
  note?: string;
};

interface Props {
  stages: Stage[];
  label: string;
  id: string;
}

const { stages, label, id } = Astro.props;
---

<div class="pipeline" data-pipeline id={id}>
  <p class="mono pipeline-label">{label}</p>

  <ol class="stages" role="list">
    {
      stages.map((s, i) => (
        <li>
          <button
            type="button"
            class:list={["stage", { "is-active": i === 0 }]}
            data-stage={i}
            aria-expanded={i === 0 ? "true" : "false"}
            aria-controls={`${id}-detail`}
          >
            <span class="stage-n mono">{s.n}</span>
            <span class="stage-title">{s.title}</span>
          </button>
        </li>
      ))
    }
  </ol>

  <div class="stage-detail" id={`${id}-detail`} aria-live="polite">
    <p data-detail>{stages[0].detail}</p>
    {stages[0].note && <p class="stage-note mono" data-note>{stages[0].note}</p>}
    {!stages[0].note && <p class="stage-note mono" data-note hidden></p>}
  </div>
</div>

<script is:inline define:vars={{ id, stages }}>
  (function () {
    const root = document.getElementById(id);
    if (!root) return;

    const detail = root.querySelector("[data-detail]");
    const note = root.querySelector("[data-note]");
    const buttons = root.querySelectorAll("[data-stage]");

    function select(i) {
      const s = stages[i];
      if (!s) return;

      buttons.forEach((b, j) => {
        const on = i === j;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-expanded", String(on));
      });

      if (detail) detail.textContent = s.detail;
      if (note) {
        if (s.note) {
          note.textContent = s.note;
          note.hidden = false;
        } else {
          note.textContent = "";
          note.hidden = true;
        }
      }
    }

    buttons.forEach((b, i) => {
      b.addEventListener("click", () => select(i));
      b.addEventListener("focus", () => select(i));
    });
  })();
</script>

<style>
  .pipeline {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-2);
    padding: 1.1rem;
    margin: 2.25rem 0;
  }

  .pipeline-label {
    margin: 0 0 0.9rem;
  }

  .stages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(128px, 1fr));
    gap: 0.4rem;
  }

  .stage {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    text-align: left;
    padding: 0.65rem 0.7rem;
    border: 1px solid var(--rule);
    border-top: 2px solid var(--rule-2);
    background: transparent;
    color: var(--ink-2);
    border-radius: var(--radius);
    cursor: pointer;
    font: inherit;
    font-size: var(--fs-sm);
    line-height: 1.3;
    transition: border-color 0.16s ease, color 0.16s ease, background 0.16s ease;
  }

  .stage:hover {
    color: var(--ink);
    border-color: var(--rule-2);
  }

  .stage.is-active {
    color: var(--ink);
    border-top-color: var(--accent);
    background: var(--accent-wash);
  }

  .stage-n {
    font-size: var(--fs-label);
  }

  .stage.is-active .stage-n {
    color: var(--accent);
  }

  .stage-title {
    font-weight: 500;
  }

  .stage-detail {
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
    font-size: var(--fs-ui);
    min-height: 4.5rem;
    max-width: 66ch;
  }

  .stage-note {
    margin-top: 0.6rem;
    font-size: var(--fs-label);
    text-transform: none;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }
</style>
