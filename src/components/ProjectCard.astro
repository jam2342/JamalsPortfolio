---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  /** The lead card gets more room and a heavier treatment. */
  lead?: boolean;
  /**
   * Heading level for the card title. The work index puts cards directly
   * under its h1, so they are h2 there; on the homepage they sit under a
   * section heading and stay h3.
   */
  level?: 2 | 3;
}

const { project, lead = false, level = 3 } = Astro.props;
const Tag = project.href ? "a" : "div";
const Heading = `h${level}` as "h2" | "h3";
---

<article
  class:list={["card", "reveal", { lead }]}
  data-tags={project.tags.join("|")}
>
  <Tag
    {...project.href ? { href: project.href } : {}}
    class="card-inner"
  >
    <header class="card-head">
      <span class="card-index mono">{project.index}</span>
      <div>
        <Heading class:list={[lead ? "h-lg" : "h-md", "card-title"]}>
          {project.title}
        </Heading>
        <p class="card-kind mono">{project.kind}</p>
      </div>
      <span class="card-years mono">{project.years}</span>
    </header>

    <p class:list={["card-blurb", { lede: lead }]}>{project.blurb}</p>

    <ul class="card-tags" role="list">
      {project.tags.map((t) => <li class="tag">{t}</li>)}
    </ul>

    {
      project.href && (
        <span class="arrow card-cta">
          {lead ? "Read the case study" : "Read more"}
        </span>
      )
    }
  </Tag>
</article>

<style>
  .card {
    border-top: 1px solid var(--rule);
  }

  .card-inner {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 1.6rem 0 1.9rem;
    position: relative;
  }

  a.card-inner::before {
    /* Accent rule that draws in on hover. */
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  a.card-inner:hover::before,
  a.card-inner:focus-visible::before {
    width: 100%;
  }

  .lead .card-inner {
    padding-block: 2.2rem 2.4rem;
  }

  .card-head {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .card-index {
    font-size: var(--fs-label);
    color: var(--accent);
  }

  .card-title {
    transition: color 0.16s ease;
  }

  a.card-inner:hover .card-title {
    color: var(--accent);
  }

  .card-kind {
    margin: 0.4rem 0 0;
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: var(--fs-sm);
    color: var(--ink-3);
  }

  .card-years {
    font-size: var(--fs-label);
    white-space: nowrap;
  }

  .card-blurb {
    margin: 0 0 1.1rem;
    max-width: 66ch;
    color: var(--ink-2);
    padding-left: 4rem;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0 0 1.1rem;
    padding-left: 4rem;
  }

  .card-cta {
    margin-left: 4rem;
  }

  @media (max-width: 640px) {
    .card-head {
      grid-template-columns: 2.2rem 1fr;
      gap: 0.75rem;
    }

    .card-years {
      grid-column: 2;
      grid-row: 2;
    }

    .card-blurb,
    .card-tags,
    .card-cta {
      padding-left: 0;
      margin-left: 0;
    }
  }
</style>
