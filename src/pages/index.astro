---
/**
 * The whole site: one map of everything Jamal has built, studied and taught.
 *
 * The interactive map is src/map/app.js. Its content (src/map/content.json),
 * nodes (src/map/data.js) and ML layout (src/map/ml.json, built by scripts/map)
 * are bundled at build time. The original interactive figures render once into
 * an off-screen store and get moved into a node's card when it opens. Visitors
 * without JavaScript get the full text as plain HTML in the noscript block.
 */
import FieldTracker from "../components/FieldTracker.astro";
import HardeningLab from "../components/HardeningLab.astro";
import RobotLogicLab from "../components/RobotLogicLab.astro";
import SolvabilityMap from "../components/SolvabilityMap.astro";
import SdeSim from "../components/SdeSim.astro";
import RouteBands from "../components/RouteBands.astro";
import MeetingFlow from "../components/MeetingFlow.astro";
import RecallGrid from "../components/RecallGrid.astro";
import { buildGraph } from "../map/data.js";
import content from "../map/content.json";
import { site } from "../data/site";

const title = "Jamal Mammadzada";
const description =
  "Jamal Mammadzada, a student engineer in Allen, Texas: computer vision for FIRST robotics, Windows security automation, a cryptography course, robotics camps for kids, and stochastic calculus research, laid out as one map.";
const origin = Astro.site ?? new URL("https://example.com");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ogImage = new URL(base + "/og.png", origin).href;
const canonical = new URL(base + "/", origin).href;

// ---- the no-JavaScript version: every page's content as plain HTML ----
const { nodes } = buildGraph();
const esc = (s) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const fixLinks = (h) => String(h).replace(/href="#" data-node="([^"]+)"/g, (_, id) => `href="#${id.split("--")[0]}"`);
function render(blocks) {
  return (blocks || []).map((b) => {
    switch (b.t) {
      case "p": case "note": return `<p>${fixLinks(b.html)}</p>`;
      case "h3": return `<h4>${esc(b.text)}</h4>`;
      case "label": return `<p><strong>${esc(b.text)}</strong></p>`;
      case "ul": return `<ul>${b.items.map((i) => `<li>${fixLinks(i)}</li>`).join("")}</ul>`;
      case "math": return `<p>${b.html}</p>`;
      case "fig": return `<figure><img src="${esc(b.src)}" alt="${esc(b.alt)}" loading="lazy"><figcaption>${esc([b.label, b.cap].filter(Boolean).join(". "))}</figcaption></figure>`;
      case "kv": return `<dl>${b.rows.map(([k, v]) => `<dt>${esc(k)}</dt><dd>${fixLinks(v)}</dd>`).join("")}</dl>`;
      case "details": return `<h4>${esc(b.s)}</h4>${render(b.blocks)}`;
      case "table": return `<table>${b.rows.map((r) => `<tr>${r.map((c) => `<td>${esc(c)}</td>`).join("")}</tr>`).join("")}</table>`;
      case "pipeline": return `<ol>${(content.pipelines[b.id] || []).map((s) => `<li><strong>${esc(s.title)}.</strong> ${esc(s.detail)}</li>`).join("")}</ol>`;
      default: return "";
    }
  }).join("");
}
const ORDER = ["frcmob", "spot", "hardening", "crypto", "eaglets", "frc5417", "notetaker", "avmac", "ee", "ia", "pico", "cyberp", "smt", "icode", "usf", "tunisia", "about", "skills", "school"];
const staticHTML = ORDER.map((id) => {
  const n = nodes.find((x) => x.id === id);
  const page = content[id];
  const parts = [`<section id="${id}"><h2>${esc(n.title)}</h2>`, n.when ? `<p><em>${esc(n.when)}</em></p>` : "", n.body ? `<p>${esc(n.body)}</p>` : ""];
  if (page) {
    parts.push(render(page.head));
    page.sections.forEach((s) => parts.push(`<h3>${esc(s.h)}</h3>`, render(s.blocks)));
  }
  if (content.roles[id]) parts.push(`<h3>My role</h3>`, render(content.roles[id].blocks));
  const comp = { pico: "picoCTF 2026", cyberp: "CyberPatriot XVIII" }[id];
  if (comp && content.comps[comp]) parts.push(`<p>${esc(content.comps[comp])}</p>`);
  parts.push("</section>");
  return parts.join("");
}).join("");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#06070a" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500&family=STIX+Two+Text:ital@0;1&display=swap" />
  </head>
  <body>
    <a href="#" class="skip" id="skip-list">Skip the map and browse everything as a list</a>
    <div id="app">
      <canvas id="graph" aria-label="A map of Jamal Mammadzada's projects, research, teaching and competitions. Use List for a text version."></canvas>
    
      <header class="intro">
        <h1><button type="button" id="home">Jamal Mammadzada</button></h1>
        <p class="p-long">Student engineer in Allen, Texas. This whole site is one map: every dot is something I built, studied or taught, wired to the things it actually connects to.</p>
        <p class="p-short">Everything I've built, studied and taught, as one map. Tap a dot, or a project below.</p>
        <div class="row">
          <button class="btn primary" id="tour" type="button">Take the tour</button>
          <div class="search">
            <input id="q" type="search" placeholder="Search everything" autocomplete="off" aria-label="Search all content" aria-controls="results">
            <ul id="results" class="results" role="listbox" hidden></ul>
          </div>
          <button class="btn" id="open-list" type="button">List</button>
        </div>
        <div class="row quick">
          <button type="button" data-open="about">About</button>·
          <button type="button" data-open="contact">Contact</button>·
          <a href="/Jamal_Mammadzada_Resume.pdf" target="_blank" rel="noopener">Résumé</a>·
          <a href="https://github.com/jam2342" target="_blank" rel="noopener">GitHub</a>·
          <button type="button" data-open="method"><span class="lg">How this map was made</span><span class="sm">How it's made</span></button>
        </div>
      </header>
    
      <nav class="keys" id="keys" aria-label="Clusters found in the content"></nav>
      <nav class="strip" id="strip" aria-label="Main projects"></nav>
      <p class="hint" id="hint">Positions come from embedding each item's text · scroll to zoom · click any dot to open it</p>
      <div class="hover-tag" id="hover-tag" hidden></div>
    
      <article class="card" id="card" hidden aria-live="polite">
        <div class="card-top">
          <nav class="crumbs" id="crumbs" aria-label="Where you are"></nav>
          <button class="expand" id="expand" type="button" aria-expanded="false" aria-controls="card">Expand</button>
          <button class="close" id="close" type="button" aria-label="Close">×</button>
        </div>
        <div class="card-scroll" id="card-scroll"></div>
        <div class="tourbar" id="tourbar" hidden>
          <span class="t-step" id="t-step"></span>
          <span class="row">
            <button class="btn" id="t-prev" type="button">Back</button>
            <button class="btn primary" id="t-next" type="button">Next</button>
            <button class="btn" id="t-end" type="button">End tour</button>
          </span>
        </div>
      </article>
    
      <section class="list" id="list" hidden aria-label="Everything as a list">
        <div class="list-inner">
          <div class="list-head">
            <h2>Everything, as a list</h2>
            <button class="btn" id="close-list" type="button">Back to the map</button>
          </div>
          <div class="list-cols" id="list-cols"></div>
        </div>
      </section>
    </div>

    <!-- The original interactive figures. Rendered once so their scripts run,
         then moved into a node's card on demand. Inert while parked. -->
    <div id="legacy-store" aria-hidden="true" inert>
      <div class="legacy" data-legacy="field"><FieldTracker /></div>
      <div class="legacy" data-legacy="recall"><RecallGrid /></div>
      <div class="legacy" data-legacy="lab"><HardeningLab /></div>
      <div class="legacy" data-legacy="logic"><RobotLogicLab /></div>
      <div class="legacy" data-legacy="flow"><MeetingFlow /></div>
      <div class="legacy" data-legacy="bands"><RouteBands /></div>
      <div class="legacy" data-legacy="solv"><SolvabilityMap /></div>
      <div class="legacy" data-legacy="sde"><SdeSim /></div>
    </div>

    <noscript>
      <style>#app { display: none; } body { overflow: auto; }</style>
      <main class="static">
        <h1>Jamal Mammadzada</h1>
        <p>Student engineer in Allen, Texas. This site is normally an interactive map; here is everything on it as plain text.</p>
        <p>Email <strong>{site.email}</strong> · <a href={site.githubUrl}>GitHub</a> · <a href="/Jamal_Mammadzada_Resume.pdf">Résumé (PDF)</a></p>
        <Fragment set:html={staticHTML} />
      </main>
    </noscript>

    <script>
      import "../map/app.js";
    </script>
  </body>
</html>

<style is:global>

/* Layout: the whole site is one full-screen graph. Opening a node unfolds its
   content into a card attached to it by a stem; a project's sections bloom out
   around it as satellites. Single deliberate dark theme from Jamal's reference:
   black field, navy dot grid, blue coordinate tags. */
:root {
  color-scheme: dark;
  --field: #06070a;
  --surface: #0c0f15;
  --surface-2: #121722;
  --line: #222a38;
  --ink: #e9edf3;
  --ink-2: #aab3c2;
  --ink-3: #6f7889;
  --tag: #2a62e8;
  --tag-ink: #f4f7ff;
  --display: "Schibsted Grotesk", "Helvetica Neue", Arial, sans-serif;
  --mono: "JetBrains Mono", ui-monospace, Menlo, monospace;
  --math: "STIX Two Text", Georgia, "Times New Roman", serif;
  --node: #cfe08a;
}
[hidden] { display: none !important; }
html, body { height: 100%; }
body {
  margin: 0; background: var(--field); color: var(--ink);
  font-family: var(--display); font-size: 15px; line-height: 1.5;
  overflow: hidden; -webkit-font-smoothing: antialiased;
}
#app { position: relative; height: 100%; overflow: hidden; }
canvas#graph { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; touch-action: none; }
canvas#graph.is-pointing { cursor: pointer; }
canvas#graph:active { cursor: grabbing; }
button, input { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--tag); outline-offset: 2px; }
a { color: inherit; }

/* ---------- intro ---------- */
.intro {
  position: absolute; top: 16px; left: 16px; z-index: 3;
  width: min(25rem, calc(100% - 32px)); display: grid; gap: 10px; pointer-events: none;
}
.intro > * { pointer-events: auto; }
.intro h1 { margin: 0; font-size: 1.55rem; line-height: 1.1; font-weight: 700; letter-spacing: -0.02em; }
.intro h1 button { background: none; border: 0; padding: 0; cursor: pointer; font-weight: inherit; }
.intro p { margin: 0; color: var(--ink-2); font-size: 0.95rem; text-shadow: 0 0 14px var(--field), 0 0 4px var(--field); }
.row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.btn {
  background: var(--surface); border: 1px solid var(--line); border-radius: 6px;
  padding: 7px 12px; font-size: 0.88rem; cursor: pointer; white-space: nowrap; text-decoration: none; color: var(--ink);
}
.btn:hover { border-color: var(--ink-3); }
.btn.primary { background: var(--tag); border-color: var(--tag); color: var(--tag-ink); font-weight: 500; }
.btn.primary:hover { filter: brightness(1.1); }
.quick { font-size: 0.86rem; color: var(--ink-3); }
.quick button, .quick a { background: none; border: 0; padding: 0; cursor: pointer; color: var(--ink-2); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; font-size: inherit; }
.quick button:hover, .quick a:hover { color: var(--ink); }
.search { position: relative; flex: 1 1 11rem; min-width: 0; }
.search input { width: 100%; box-sizing: border-box; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 7px 10px; font-size: 0.88rem; }
.search input::placeholder { color: var(--ink-3); }
.results {
  position: absolute; top: calc(100% + 4px); left: 0; width: min(26rem, calc(100vw - 32px)); margin: 0; padding: 4px;
  list-style: none; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; max-height: 22rem; overflow: auto;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
}
.results button { display: grid; gap: 2px; width: 100%; text-align: left; background: none; border: 0; border-radius: 5px; padding: 7px 9px; cursor: pointer; }
.results button:hover, .results button[aria-selected="true"] { background: var(--surface-2); }
.results .r-title { display: flex; align-items: center; gap: 8px; font-size: 0.9rem; }
.results .r-where { font-size: 0.76rem; color: var(--ink-3); }
.results .r-snip { font-size: 0.8rem; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.results mark { background: rgba(42, 98, 232, 0.35); color: var(--ink); border-radius: 2px; }
.swatch { width: 8px; height: 8px; border-radius: 50%; flex: none; display: inline-block; }

/* ---------- topic keys, hint ---------- */
.keys { position: absolute; left: 16px; bottom: 16px; z-index: 3; display: flex; flex-wrap: wrap; gap: 6px; max-width: calc(100% - 32px); }
.tkey { display: inline-flex; align-items: center; gap: 7px; background: rgba(12, 15, 21, 0.86); border: 1px solid var(--line); border-radius: 999px; padding: 5px 11px 5px 9px; font-size: 0.82rem; cursor: pointer; }
.tkey[aria-pressed="true"] { border-color: currentColor; }
.tkey .n { font-family: var(--mono); font-size: 0.72rem; color: var(--ink-3); }
.hint { position: absolute; z-index: 2; left: 50%; bottom: 64px; transform: translateX(-50%); font-size: 0.82rem; color: var(--ink-3); white-space: nowrap; pointer-events: none; transition: opacity 0.4s; }
#app.has-card .intro p, #app.has-card .intro .quick, #app.has-card .hint { display: none; }
.teaser { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; background: #090c12; }
.teaser span { color: var(--ink-2); font-size: 0.9rem; }
.nn { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
.nn button { width: 100%; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 9px; background: none; border: 0; border-radius: 6px; padding: 6px 8px; cursor: pointer; text-align: left; color: var(--ink-2); font-size: 0.88rem; }
.nn button:hover { background: var(--surface-2); color: var(--ink); }
.nn .nn-c { font-family: var(--mono); font-size: 0.78rem; color: var(--ink-3); font-variant-numeric: tabular-nums; }
.sec-h { display: flex; align-items: center; gap: 6px; }
.info { width: 18px; height: 18px; border-radius: 50%; border: 1px solid var(--line); background: none; color: var(--ink-3); font-size: 0.7rem; line-height: 1; cursor: pointer; padding: 0; }
.info:hover { color: var(--ink); border-color: var(--ink-3); }
.tkey.toggle .dash { width: 16px; height: 0; border-top: 1.5px dashed var(--ink-2); }
.tkey.toggle[aria-pressed="true"] { border-color: var(--ink-2); }
.links button[data-cluster] { font-size: 0.86rem; }
.hover-tag {
  position: absolute; z-index: 2; pointer-events: none; max-width: 18rem;
  background: var(--tag); color: var(--tag-ink); font-family: var(--mono); font-size: 11px; line-height: 1.35;
  padding: 4px 7px; border-radius: 2px; transform: translate(12px, -50%);
}
.hover-tag b { font-family: var(--display); font-weight: 500; font-size: 12px; margin-right: 6px; }
.hover-tag.why { font-family: var(--display); font-size: 12px; background: var(--surface-2); color: var(--ink); border: 1px solid var(--line); border-radius: 6px; }

/* ---------- the node card ---------- */
.card {
  position: absolute; z-index: 4; top: 16px; right: 16px; bottom: 16px; width: min(29rem, calc(100% - 32px));
  background: var(--surface); border: 1px solid var(--line); border-top: 2px solid var(--node); border-radius: 10px;
  display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 24px 70px rgba(0, 0, 0, 0.55);
  transform-origin: 0% 30%;
}
.card.wide { width: min(64rem, calc(100% - 32px)); }
.card.opening { animation: unfold 0.32s cubic-bezier(0.2, 0.8, 0.2, 1); }
@keyframes unfold { from { opacity: 0; transform: scale(0.82) translateX(-24px); } to { opacity: 1; transform: none; } }
.card-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 12px 10px 18px; border-bottom: 1px solid var(--line); }
.crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; font-size: 0.8rem; color: var(--ink-3); min-width: 0; }
.crumbs button { background: none; border: 0; padding: 2px 4px; border-radius: 4px; cursor: pointer; color: var(--ink-2); font-size: inherit; }
.crumbs button:hover { color: var(--ink); background: var(--surface-2); }
.crumbs .here { color: var(--ink); padding: 2px 4px; }
.close { background: none; border: 1px solid var(--line); border-radius: 6px; width: 30px; height: 30px; cursor: pointer; flex: none; font-size: 1rem; line-height: 1; color: var(--ink-2); }
.close:hover { color: var(--ink); border-color: var(--ink-3); }
.card-scroll { overflow: auto; padding: 18px 22px 26px; display: grid; gap: 14px; align-content: start; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.tchip { display: inline-flex; align-items: center; gap: 6px; font-size: 0.78rem; color: var(--ink-2); border: 1px solid var(--line); border-radius: 999px; padding: 2px 9px 2px 7px; }
.card h2 { margin: 0; font-size: 1.6rem; line-height: 1.12; letter-spacing: -0.018em; font-weight: 700; text-wrap: balance; }
.when { margin: -8px 0 0; color: var(--ink-3); font-size: 0.85rem; font-variant-numeric: tabular-nums; }
.content { display: grid; gap: 13px; min-width: 0; }
.content > p { margin: 0; color: var(--ink-2); max-width: 64ch; line-height: 1.62; }
.content > p.lede { color: var(--ink); font-size: 1.06rem; line-height: 1.55; }
.content > h3 { margin: 10px 0 -4px; font-size: 1.02rem; font-weight: 700; color: var(--ink); }
.content > .label { margin: 8px 0 -6px; font-size: 0.8rem; font-weight: 500; color: var(--ink-3); }
.content > ul { margin: 0; padding-left: 1.1rem; color: var(--ink-2); display: grid; gap: 6px; max-width: 64ch; }
.content > ul > li { line-height: 1.55; }
.content > :not(.legacy) a { color: var(--ink); text-decoration: underline; text-decoration-color: rgba(233, 237, 243, 0.3); text-underline-offset: 3px; }
.content a[data-node] { text-decoration-color: var(--node); text-decoration-thickness: 2px; }
.content > :not(.legacy) a:hover { text-decoration-color: currentColor; }
.content > :not(.legacy) code { font-family: var(--mono); font-size: 0.85em; background: var(--surface-2); padding: 1px 5px; border-radius: 4px; color: var(--ink); }
.content > :not(.legacy) strong { color: var(--ink); font-weight: 500; }
.content > .note { border: 1px solid var(--line); background: var(--surface-2); border-radius: 8px; padding: 10px 12px; font-size: 0.9rem; }
.content > figure { margin: 4px 0; display: grid; gap: 7px; }
.content > figure img { width: 100%; height: auto; border-radius: 6px; border: 1px solid var(--line); background: #000; }
.content > figure figcaption { font-size: 0.84rem; color: var(--ink-3); line-height: 1.5; }
.content > figure figcaption b { color: var(--ink-2); font-weight: 500; margin-right: 6px; }
.content > dl { margin: 0; display: grid; grid-template-columns: minmax(6.5rem, max-content) 1fr; gap: 6px 14px; font-size: 0.88rem; }
.content > dl > dt { color: var(--ink-3); }
.content > dl > dd { margin: 0; color: var(--ink-2); min-width: 0; }
.content > details { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; background: rgba(18, 23, 34, 0.5); }
.content > details > summary { cursor: pointer; font-weight: 500; color: var(--ink); font-size: 0.95rem; }
.content > details[open] > summary { margin-bottom: 10px; }
.content > details > .content { gap: 10px; }
.tablewrap { overflow-x: auto; }
.tablewrap table { border-collapse: collapse; font-size: 0.86rem; min-width: 100%; }
.tablewrap caption { text-align: left; color: var(--ink-3); font-size: 0.8rem; padding-bottom: 6px; }
.tablewrap th, .tablewrap td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); color: var(--ink-2); font-variant-numeric: tabular-nums; }
.tablewrap tr:first-child th { color: var(--ink-3); font-weight: 500; }
.math { font-family: var(--math); font-size: 1.05em; color: var(--ink); }
.math-display { display: block; text-align: center; padding: 10px 6px; overflow-x: auto; font-size: 1.15rem; }
.math sub, .math sup { font-size: 0.7em; }
.frac { display: inline-flex; flex-direction: column; vertical-align: middle; text-align: center; font-size: 0.85em; line-height: 1.1; margin: 0 2px; }
.frac > span:first-child { border-bottom: 1px solid currentColor; padding: 0 2px; }
.op { font-style: normal; }
.sqrt { border-top: 1px solid currentColor; padding: 0 2px; margin-left: 0.6em; position: relative; }
.sqrt::before { content: "\221A"; position: absolute; left: -0.62em; top: -0.1em; }
.stages { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; counter-reset: s; }
.stages li { display: grid; grid-template-columns: 1.8rem 1fr; gap: 4px 10px; color: var(--ink-2); }
