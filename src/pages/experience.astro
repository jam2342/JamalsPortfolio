---
import Base from "../layouts/Base.astro";
import CtfBreakdown from "../components/CtfBreakdown.astro";
import { roles, competitions, skillGroups } from "../data/experience";
import { site } from "../data/site";

const ctf = competitions.find((c) => c.breakdown)!;
const others = competitions.filter((c) => !c.breakdown);
---

<Base
  title="Experience, Jamal Mammadzada"
  description="Experience and leadership: Eaglets robotics education, CyberPatriot security automation, FRC Team 5417, FIRST Global Team Tunisia, and technical instruction."
>
  <section class="wrap page-head">
    <p class="mono">Experience</p>
    <h1 class="h-lg">Experience and leadership</h1>
    <p class="lede narrow">
      Engineering roles, teaching roles, and the ones that turned out to be both.
    </p>
  </section>

  <section class="wrap section" aria-labelledby="roles">
    <div class="rubric">
      <p class="mono" id="roles">Roles</p>
    </div>

    <ol class="roles" role="list">
      {
        roles.map((r) => (
          <li class="role reveal">
            <div class="role-side">
              <p class="mono role-dates">{r.dates}</p>
              {r.location && <p class="mono role-loc">{r.location}</p>}
            </div>

            <div class="role-main">
              <h2 class="h-sm role-org">{r.org}</h2>
              <p class="role-title">{r.title}</p>

              <ul class="role-points" role="list">
                {r.points.map((p) => <li>{p}</li>)}
              </ul>

              {r.teamCredits && (
                <ul class="credits" role="list">
                  {r.teamCredits.map((c) => (
                    <li>
                      <span class="mono credit-mark">◆</span>
                      {c}
                    </li>
                  ))}
                </ul>
              )}

              {r.datesUnconfirmed && (
                <p class="note role-flag">
                  Exact dates still to be confirmed.
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap section" aria-labelledby="edu">
    <div class="rubric">
      <p class="mono" id="edu">Education</p>
    </div>

    <div class="edu">
      <div class="role-side">
        <p class="mono role-dates">Expected {site.graduation}</p>
        <p class="mono role-loc">{site.location}</p>
      </div>
      <div class="role-main">
        <h2 class="h-sm role-org">{site.school}</h2>
        <p class="role-title">{site.program}, diploma candidate</p>
        <ul class="role-points" role="list">
          <li>Current coursework: {site.coursework.join(", ")}.</li>
          <li>
            Prior: IB Mathematics HL I / AP Calculus BC, IB Physics SL.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="comps">
    <div class="rubric">
      <p class="mono" id="comps">Competitions</p>
    </div>

    <div class="reveal ctf-wrap">
      <CtfBreakdown comp={ctf} />
    </div>

    <ul class="comp-list" role="list">
      {
        others.map((c) => (
          <li class="comp reveal">
            <div>
              <h2 class="h-sm">{c.name}</h2>
              <p class="comp-detail">{c.detail}</p>
            </div>
            <div class="comp-side">
              <p class="comp-result">{c.result}</p>
              {c.year && <p class="mono">{c.year}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="skills">
    <div class="rubric">
      <p class="mono" id="skills">Skills</p>
    </div>

    <p class="narrow skills-intro">
      Grouped by the kind of work they support. Everything listed was used to
      build something on this site.
    </p>

    <div class="skill-grid">
      {
        skillGroups.map((g) => (
          <div class="skill-block reveal">
            <h2 class="mono skill-head">{g.group}</h2>
            <ul role="list">
              {g.items.map((i) => <li>{i}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap section">
    <div class="resume-cta">
      <div>
        <h2 class="h-md">Full résumé</h2>
        <p class="dim resume-note">Choose the standard one-page résumé or the visual edition.</p>
      </div>
      <div class="resume-actions">
        <a href={site.resume} class="btn">Standard PDF</a>
        <a href={site.resumeVisual} class="btn btn-ghost">Visual PDF</a>
        <a href={site.resumeDocx} class="btn btn-ghost">Standard Word</a>
        <a href={site.resumeVisualDocx} class="btn btn-ghost">Visual Word</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-top: clamp(3rem, 7vw, 5rem);
  }

  .page-head .mono {
    margin-bottom: 1.1rem;
  }

  .page-head h1 {
    margin-bottom: 1.25rem;
  }

  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .role,
  .edu {
    display: grid;
    grid-template-columns: minmax(10rem, 15rem) 1fr;
    gap: 2rem;
    padding: 1.7rem 0;
    border-top: 1px solid var(--rule);
  }

  .roles .role:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .edu {
    border-bottom: 1px solid var(--rule);
  }

  .role-dates {
    margin: 0;
    color: var(--ink-2);
  }

  .role-loc {
    margin: 0.35rem 0 0;
    font-size: var(--fs-label);
  }

  .role-org {
    margin-bottom: 0.3rem;
  }

  .role-title {
    margin: 0 0 0.9rem;
    color: var(--accent);
    font-size: var(--fs-ui);
  }

  .role-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    max-width: 62ch;
  }

  .role-points li {
    position: relative;
    padding-left: 1rem;
    font-size: var(--fs-ui);
    color: var(--ink-2);
  }

  .role-points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 5px;
    height: 1px;
    background: var(--rule-2);
  }

  .credits {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .credits li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: var(--fs-ui);
    color: var(--ink);
    font-weight: 500;
  }

  .credit-mark {
    color: var(--accent);
    font-size: var(--fs-label);
  }

  .role-flag {
    margin-top: 1rem;
    font-size: var(--fs-sm);
  }

  /* -- Competitions -- */

  .ctf-wrap {
    margin-bottom: 2.25rem;
  }

  .comp-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .comp {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
    align-items: start;
    padding: 1.35rem 0;
    border-top: 1px solid var(--rule);
  }

  .comp:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .comp-detail {
    margin: 0.45rem 0 0;
    color: var(--ink-2);
    font-size: var(--fs-ui);
    max-width: 58ch;
  }

  .comp-areas {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.85rem 0 0;
    padding: 0;
  }

  .comp-side {
    text-align: right;
  }

  .comp-result {
    margin: 0;
    font-weight: 600;
    font-size: var(--fs-ui);
    color: var(--accent);
  }

  .comp-side .mono {
    margin: 0.25rem 0 0;
    font-size: var(--fs-label);
  }

  /* -- Skills -- */

  .skills-intro {
    margin-bottom: 2rem;
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 2rem;
  }

  .skill-block {
    border-top: 1px solid var(--rule);
    padding-top: 0.9rem;
  }

  .skill-head {
    margin: 0 0 0.85rem;
    color: var(--accent);
    font-size: var(--fs-label);
  }

  .skill-block ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    font-size: var(--fs-ui);
    color: var(--ink-2);
  }

  /* -- Résumé -- */

  .resume-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border-top: 1px solid var(--rule);
    padding-top: 2rem;
  }

  .resume-note {
    margin: 0.35rem 0 0;
    font-size: var(--fs-ui);
  }

  .resume-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  @media (max-width: 720px) {
    .role,
    .edu {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .role-side {
      display: flex;
      align-items: baseline;
      gap: 0.8rem;
    }

    .role-loc {
      margin: 0;
    }

    .comp {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .comp-side {
      text-align: left;
      display: flex;
      align-items: baseline;
      gap: 0.7rem;
    }

    .comp-side .mono {
      margin: 0;
    }
  }
</style>
