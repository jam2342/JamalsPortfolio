---
/** Anything that isn't the map. Old page URLs redirect (astro.config.mjs); this is for the rest. */
const home = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found · Jamal Mammadzada</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;700&display=swap" />
    <style>
      :root { color-scheme: dark; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #06070a; color: #e9edf3; font-family: "Schibsted Grotesk", "Helvetica Neue", Arial, sans-serif; padding-inline: 16px; }
      main { max-width: 30rem; display: grid; gap: 12px; }
      h1 { margin: 0; font-size: 1.6rem; }
      p { margin: 0; color: #aab3c2; line-height: 1.55; }
      a { color: #e9edf3; text-decoration-color: #2a62e8; text-underline-offset: 3px; }
    </style>
  </head>
  <body>
    <main>
      <h1>That page doesn't exist.</h1>
      <p>This whole site is one map now, so every project, write-up and fact lives on a single page.</p>
      <p><a href={home}>Open the map</a></p>
    </main>
  </body>
</html>
