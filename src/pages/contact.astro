---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { courseUrl } from "../data/course";
---

<Base
  title="Contact, Jamal Mammadzada"
  description="Contact Jamal Mammadzada about research, robotics, technical education, or engineering opportunities."
>
  <section class="wrap page-head">
    <p class="mono">Contact</p>
    <h1 class="h-lg">Get in touch</h1>
    <p class="lede narrow">
      If you're working on machine learning, robotics, security, or technical
      education and there's overlap with what I do, I'd like to hear about it.
      Email is the best way to reach me and I answer everything that isn't spam.
    </p>
  </section>

  <section class="wrap section" aria-labelledby="details">
    <h2 class="sr-only" id="details">Contact details</h2>

    <div class="contact-grid">
      <a class="contact-card" href={`mailto:${site.email}`}>
        <span class="mono card-label">Email</span>
        {/* Split at the @ so the address wraps there rather than mid-word. */}
        <span class="card-value">
          {site.email.split("@")[0]}<wbr />@{site.email.split("@")[1]}
        </span>
        <span class="card-note">Best way to reach me.</span>
      </a>

      <a class="contact-card" href={site.githubUrl} rel="me noopener">
        <span class="mono card-label">GitHub</span>
        <span class="card-value">github.com/{site.github}</span>
        <span class="card-note">
          Public repositories. Most project work is in private repositories.
        </span>
      </a>

      {
        courseUrl && (
          <a class="contact-card" href={courseUrl} rel="noopener">
            <span class="mono card-label">Udemy</span>
            <span class="card-value">Practical Cryptography</span>
            <span class="card-note">
              My course for developers and QA engineers.
            </span>
          </a>
        )
      }

      <div class="contact-card is-static">
        <span class="mono card-label">Location</span>
        <span class="card-value">{site.location}</span>
        <span class="card-note">
          Available for remote work; in person around the Dallas–Fort Worth area.
        </span>
      </div>

      {/* Two separate links; nesting an <a> inside an <a> is invalid and the
          browser breaks the outer one out of the card. */}
      <div class="contact-card is-static">
        <span class="mono card-label">Résumé</span>
        <span class="card-value">
          <a href={site.resume}>Download PDF</a>
        </span>
        <span class="card-note">
          Also available as <a href={site.resumeDocx}>a Word document</a>.
        </span>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="good-for">
    <div class="rubric">
      <p class="mono" id="good-for">Worth writing about</p>
    </div>

    <div class="reasons">
      <div class="reason reveal">
        <h3 class="h-sm">Research and internships</h3>
        <p>
          Programs, labs, or teams working on machine learning, computer vision,
          or applied mathematics. I'm a high school student, and I'm aware that
          narrows things. I'd still rather ask.
        </p>
      </div>
      <div class="reason reveal">
        <h3 class="h-sm">Robotics</h3>
        <p>
          Scouting and match analysis, or anything involving vision on a
          competition field. If you run an FRC team and want to talk about what
          FRCMOB does, I'm happy to.
        </p>
      </div>
      <div class="reason reveal">
        <h3 class="h-sm">Technical education</h3>
        <p>
          Curriculum, robot kits, or bringing a camp somewhere. Eaglets runs free
          programs for grades 3–8 and is always looking at partnerships.
        </p>
      </div>
      <div class="reason reveal">
        <h3 class="h-sm">Collaboration</h3>
        <p>
          Students or organizations working on something adjacent. The projects
          here are mostly solo, and that's not by preference.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="closing">
      <p class="mono">Education</p>
      <p class="closing-line">
        {site.school} · {site.program} · Expected {site.graduation}
      </p>
      <p class="dim closing-note">
        Additional contact details are on the résumé.
      </p>
    </div>
  </section>
</Base>

<style>
  /* Shorter sections than a case study, so less air between them. */
  .section {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .page-head {
    padding-top: clamp(3rem, 7vw, 5rem);
  }

  .page-head .mono {
    margin-bottom: 1.1rem;
  }

  .page-head h1 {
    margin-bottom: 1.25rem;
  }

  /* Five cards on one row. auto-fit would wrap the fifth onto a row of its
     own and leave a dead half-width block beside it. */
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }

  /* 5 cards never divide evenly below 5 columns, so the last card spans the
     remainder of its row. Ordered widest-first so the cascade resolves. */
  @media (max-width: 1100px) {
    .contact-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .contact-grid > :last-child {
      grid-column: span 2;
    }
  }

  @media (max-width: 760px) {
    .contact-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .contact-grid > :last-child {
      grid-column: span 2;
    }
  }

  @media (max-width: 480px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-grid > :last-child {
      grid-column: span 1;
    }
  }

  .contact-card {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.4rem 1.25rem 1.6rem;
    background: var(--paper-2);
    text-decoration: none;
    color: inherit;
    transition: background 0.16s ease;
  }

  a.contact-card:hover {
    background: var(--accent-wash);
  }

  .card-label {
    color: var(--accent);
  }

  .card-value {
    font-size: var(--fs-ui);
    font-weight: 500;
    letter-spacing: -0.012em;
    /* <wbr> supplies the break point; anywhere is the fallback if the
       column gets narrower than the local part of the address. */
    overflow-wrap: anywhere;
    hyphens: none;
    min-width: 0;
  }

  .card-value a {
    text-decoration-color: var(--rule-2);
  }

  @media (pointer: coarse) {
    .card-value a,
    .card-note a {
      display: inline-flex;
      align-items: center;
      min-height: 32px;
    }
  }

  .card-value a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  a.contact-card:hover .card-value {
    color: var(--accent);
  }

  .card-note {
    font-size: var(--fs-sm);
    color: var(--ink-3);
    line-height: 1.5;
  }

  .reasons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 2rem;
  }

  .reason {
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
  }

  .reason h3 {
    margin-bottom: 0.55rem;
  }

  .reason p {
    font-size: var(--fs-ui);
    color: var(--ink-2);
    margin: 0;
  }

  .closing {
    border-top: 1px solid var(--rule);
    padding-top: 1.75rem;
  }

  .closing .mono {
    margin-bottom: 0.6rem;
  }

  .closing-line {
    margin: 0;
    font-size: 1rem;
  }

  .closing-note {
    margin: 0.5rem 0 0;
    font-size: var(--fs-ui);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
