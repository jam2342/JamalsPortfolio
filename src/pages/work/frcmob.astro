---
import Base from "../../layouts/Base.astro";
import FieldTracker from "../../components/FieldTracker.astro";
import Pipeline from "../../components/Pipeline.astro";
import ModelMetrics from "../../components/ModelMetrics.astro";
import RecallGrid from "../../components/RecallGrid.astro";
import Figure from "../../components/Figure.astro";
import EvidenceStrip from "../../components/EvidenceStrip.astro";
import { projects } from "../../data/projects";
import { detector } from "../../data/model";

const project = projects.find((p) => p.id === "frcmob")!;

const visionStages = [
  {
    n: "01",
    title: "Acquire",
    detail:
      "A match clip is pulled from stream footage or stored video and cut down to the window that matters. Frames come out at a fixed rate so timing stays comparable between matches.",
  },
  {
    n: "02",
    title: "Detect",
    detail:
      "A YOLO detector trained on competition footage finds robots in each frame. The model is single-class. It learns what a competition robot looks like, which a general-purpose model does badly.",
    note: "Falls back to a generic model only in a degraded mode, and runs that do are flagged rather than reported as normal.",
  },
  {
    n: "03",
    title: "Track",
    detail:
      "ByteTrack associates detections across frames into continuous tracks, so a robot keeps one identity through occlusion and traffic instead of becoming six unrelated detections.",
    note: "Association tolerates short gaps; a motion-based estimate fills in when a robot is briefly lost.",
  },
  {
    n: "04",
    title: "Calibrate",
    detail:
      "AprilTags around the field give image-to-field point correspondences, and a homography is fit over them with RANSAC. Candidates are judged on inlier ratio and reprojection error, and rejected if the fit is poor.",
    note: "From stands distance the tags are often unresolvable. The fallback is four corner taps from the scout, carried frame to frame by optical flow.",
  },
  {
    n: "05",
    title: "Map",
    detail:
      "The homography converts every tracked pixel position into field coordinates. From that point on the data is spatial: positions, speeds, and zone occupancy rather than pixels.",
  },
  {
    n: "06",
    title: "Summarize",
    detail:
      "Tracks become metrics: zone dwell time, reconstructed cycles, disabled periods, movement profiles. Those feed the ratings engine and the draft scouting forms.",
  },
];
---

<Base
  title="FRCMOB, Jamal Mammadzada"
  description="A case study on FRCMOB: a full-stack scouting and match-analysis platform that turns FIRST Robotics match video into reviewable strategic evidence."
  progress={true}
>
  <article>
    <header class="wrap case-head">
      <p class="mono">
        <a href="/work/">Work</a> / Case study {project.index}
      </p>
      <h1 class="h-xl case-title">FRCMOB</h1>
      <p class="lede narrow case-lede">
        Built and deployed for FRC Team 5417, FRCMOB is a full-stack scouting
        and match-analysis platform supporting multi-scout data collection,
        offline submissions, strategy analysis, and computer-vision auto-scouting.
      </p>

      <dl class="meta-grid case-meta">
        {
          project.meta.map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
        <div>
          <dt>Years</dt>
          <dd>{project.years}</dd>
        </div>
      </dl>

      <p class="note case-note">
        FRCMOB is open source under the GNU AGPL v3. The public repository
        includes the web app, API, worker, game configuration, deployment setup,
        documentation, and tests. Model weights, training data, match recordings,
        database contents, and credentials remain private.
      </p>

      <div class="case-actions">
        <a
          href={project.repoUrl}
          class="btn"
          target="_blank"
          rel="noreferrer"
        >View source on GitHub ↗</a>
        <a
          href="https://scouting-app-iryg.vercel.app/#/home"
          class="btn btn-ghost"
          target="_blank"
          rel="noreferrer"
        >Open the public frontend ↗</a>
        <p class="mono">Cloud services are intentionally paused; offline tools still render.</p>
      </div>
    </header>

    <div class="wrap case-proof">
      <EvidenceStrip
        label="FRCMOB evidence"
        items={[
          { value: detector.trainImages.toLocaleString(), label: "Labeled frames", detail: `${detector.reviewedImages.toLocaleString()} manually reviewed` },
          { value: "Competition", label: "Real deployment", detail: "Used by FRC Team 5417" },
          { value: `${(detector.v2.map50 * 100).toFixed(1)}%`, label: "Holdout mAP@50", detail: "v2 promotion benchmark" },
          { value: "100", label: "Test files", detail: "66 backend · 34 frontend in the public repository" },
        ]}
      />
    </div>

    <section class="wrap section narrow" aria-labelledby="problem">
      <h2 class="h-lg sec-title" id="problem">The problem</h2>

      <p>
        Alliance selection is the highest-stakes decision a team makes at a
        competition, and it's usually made on thin evidence. The standard method
        is manual scouting: students in the stands watch a match and fill out a
        form. Six robots move at once for two and a half minutes. A scout tracks
        one of them, usually while also trying to count scoring cycles.
      </p>

      <p>
        The data that comes back has predictable problems. Scouts miss things
        when the field gets crowded. Different people apply the same rating scale
        differently, so a "4 out of 5" from one scout doesn't mean what it means
        from another. Coverage is uneven, and the teams you most want data on are
        often the ones nobody was assigned to watch. And by the time you notice a
        gap, that match is over.
      </p>

      <p>
        Video doesn't have those problems. It's complete, it's re-watchable, and
        it's the same every time you look at it. The obstacle is that nobody has
        the hours to watch it. FRCMOB is an attempt to close that gap: process
        the footage automatically, then put a person in front of the result
        before it counts for anything.
      </p>

      <p>
        I began FRCMOB in February 2026 for{" "}
        <a href="/work/frc5417/">my own team</a>. Team 5417 has since used the
        platform at a real competition. I am still improving the computer-vision
        auto-scouting, offline data collection, mobile reliability, model
        evaluation, and strategy tools.
      </p>

      <h3 class="h-md sub-title">The design constraint that shaped everything</h3>

      <p>
        A model that's right most of the time is not automatically useful here. If
        a strategy team can't tell which numbers to trust, a confident wrong
        answer is worse than no answer, because it gets acted on. So the system was built
        so that nothing produced by a model becomes accepted data on its own.
        Every automatic result carries a confidence value, and a human either
        approves it, corrects specific fields, or throws it out.
      </p>
    </section>

    <section class="wrap section" aria-labelledby="transform">
      <h2 class="h-lg sec-title narrow" id="transform">Camera space to field space</h2>

      <p class="narrow">
        Everything spatial depends on one transform. A camera in the stands
        produces a foreshortened image where the far end of the field is
        compressed into a fraction of the frame. Strategy questions are about
        real positions. The homography is what connects the two, and if it's
        wrong every downstream metric is wrong with it.
      </p>

      <FieldTracker />
    </section>

    <section class="wrap section" aria-labelledby="pipeline">
      <h2 class="h-lg sec-title narrow" id="pipeline">The vision pipeline</h2>

      <p class="narrow">
        Six stages take a video file to structured spatial data. Select a stage
        to read what it does.
      </p>

      <Pipeline
        id="vision-pipeline"
        label="Video → field coordinates"
        stages={visionStages}
      />

      <div class="narrow">
        <details class="tech">
          <summary>Why the AprilTag fallback exists</summary>
          <p>
            On paper, calibration is automatic: detect the fiducials, solve for
            the matrix, done. Testing on real footage showed the tags are
            frequently unresolvable at the distance and angle a phone in the
            stands actually films from. There are too few pixels on the tag to decode.
          </p>
          <p>
            The fallback asks the scout to tap the four field corners once. That
            gives the same four correspondences, and optical flow carries the
            pose forward as the camera moves, instead of trying to re-detect tags
            every frame. It's a worse method in principle and the only one that
            works from row 20.
          </p>
        </details>

        <details class="tech">
          <summary>Reading team numbers off bumpers</summary>
          <p>
            Tracking gives continuous identities, but not which team a track
            belongs to. OCR on bumper numbers supplies that, which is hard at
            competition distance. Motion blur, angle, and partial occlusion all
            work against it.
          </p>
          <p>
            What makes it tractable is that the answer set is closed. There are
            exactly six teams on the field and the match schedule says which.
            Rather than trusting any single frame, reads are accumulated across
            the track and voted on over time, and the assignment is made against
            those six known candidates.
          </p>
        </details>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="model">
      <h2 class="h-lg sec-title narrow" id="model">Training the detector</h2>

      <p class="narrow">
        General-purpose detectors barely register competition robots. They aren't
        in the training distribution of a model trained on everyday objects.
        The detector here is single-class, trained on{" "}
        {detector.trainImages.toLocaleString()} labeled frames of match footage
        with a reviewed subset of {detector.reviewedImages.toLocaleString()} images.
      </p>

      <p class="narrow">
        The number worth paying attention to is the second one.
      </p>

      <div class="detection-plates reveal" aria-label="Examples from the reviewed Roboflow dataset">
        <figure>
          <img
            src="/img/frcmob/roboflow-detections-wide.png"
            alt="A FIRST Robotics broadcast frame with three robots marked by lime detection boxes across a foreshortened field."
            width="1280"
            height="720"
            loading="lazy"
          />
          <figcaption>
            <span class="mono">Reviewed frame · 03 detections</span>
            A relatively clean broadcast view. Even here, the robots occupy only
            a small fraction of the frame and the sponsor panel obscures the
            center foreground.
          </figcaption>
        </figure>
        <figure>
          <img
            src="/img/frcmob/roboflow-detections-dense.png"
            alt="A crowded FIRST Robotics broadcast frame with robots marked by detection boxes across the main view and two picture-in-picture views."
            width="1280"
            height="720"
            loading="lazy"
          />
          <figcaption>
            <span class="mono">Reviewed frame · crowded field</span>
            The harder case: robots cross, shrink into the far field, and appear
            again in picture-in-picture views. These are annotations from the
            real-broadcast dataset, not a staged visualization.
          </figcaption>
        </figure>
      </div>

      <ModelMetrics />

      <div class="narrow">
        <p>
          The v1 run scored {(detector.v1.map50 * 100).toFixed(1)}% mAP@50 on its
          validation split, which sounds finished and isn't. That split is drawn
          from the same events, the same venues, and often the same matches as
          the training data. It measures whether the model learned the frames it
          was shown. It says very little about a competition it has never seen.
        </p>
      </div>

      <RecallGrid />

      <div class="narrow">

        <p>
          So one full event, {detector.holdoutEvent}, was held out entirely and
          locked as a benchmark. Against that, the same model scored
          {" "}{(detector.v1HoldoutMap50 * 100).toFixed(1)}%. That drop is the real
          measurement, and it's the one that governs whether a new model ships.
          v2 was promoted because it reached
          {" "}{(detector.v2.map50 * 100).toFixed(1)}% on that locked holdout, not
          because its loss curves looked better.
        </p>

        <details class="tech">
          <summary>Precision {(detector.v2.precision * 100).toFixed(0)}%, recall {(detector.v2.recall * 100).toFixed(0)}%, and why that tradeoff is the right one</summary>
          <p>
            On the holdout, v2 is precise and comparatively conservative: when it
            calls something a robot it's almost always right, but it misses
            detections it isn't sure about. For this system that's the correct
            direction to err.
          </p>
          <p>
            A missed detection is a gap ByteTrack can bridge and a human reviewer
            can see. A false detection is a phantom robot with a trajectory, a
            zone history, and cycles attributed to it. That noise propagates
            into the ratings and looks exactly like real data. Recall is the
            number I'd most like to improve, but not by trading precision for it.
          </p>
        </details>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="arch">
      <h2 class="h-lg sec-title narrow" id="arch">System architecture</h2>

      <p class="narrow">
        Video analysis is slow and competitions are not. The architecture is
        shaped around keeping heavy work off the request path and keeping the
        interface usable on venue wifi, which frequently means no wifi at all.
      </p>

      <div class="arch-grid">
        {
          project.stack.map((group) => (
            <div class="arch-block reveal">
              <p class="mono arch-head">{group.group}</p>
              <ul role="list">
                {group.items.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          ))
        }
      </div>

      <Figure
        src="/img/jamal-oracle.jpg"
        alt="Jamal at a workbench in the robotics lab with a laptop open to a terminal session on the deployment server."
        label="Plate 01"
        caption="Bringing up the Oracle Cloud instance that runs the backend. The screen is deliberately obscured here; it was an SSH session into the deployment host."
        width={1500}
        height={1042}
      />

      <div class="narrow">
        <p>
          A FastAPI backend handles the API and owns the schema in PostgreSQL.
          Anything expensive gets pushed onto Redis-backed workers: video
          extraction, detection, tracking, ratings recomputation. A request
          returns immediately and the job reports progress as it runs. The whole
          thing is containerized so a competition deployment matches development.
        </p>

        <p>
          The frontend is React and TypeScript, built offline-first. Scouts lose
          connectivity constantly in a venue; submissions queue locally and sync
          when the network comes back rather than failing. Part of the analysis
          also runs in the browser through ONNX Runtime Web, so a device can do
          its own match breakdown with no server at all.
        </p>

        <details class="tech">
          <summary>Running it somewhere other than my laptop</summary>
          <p>
            Getting this deployed taught me as much as building it. The stack
            runs across an Oracle Cloud container instance for the backend and a
            second one for the worker, with managed Postgres and Redis, and the
            frontend hosted separately. Splitting the API and the worker into
            separate instances isn't optional: without a worker running, every
            analysis job queues forever and nothing in the video pipeline
            executes.
          </p>
          <p>
            The failures were all the unglamorous kind. Network rules that had to
            explicitly permit outbound traffic to the database and Redis hosts.
            A database URL that needed the right driver prefix because the code
            uses psycopg3. Model weights that are gitignored, which means they
            either get baked into the image at build time or downloaded from
            object storage at startup, and if neither happens the pipeline
            silently falls back to a generic detector. I ended up writing strict
            startup validation so a misconfigured deployment fails loudly on boot
            instead of producing quietly wrong results all weekend.
          </p>
        </details>

        <details class="tech">
          <summary>Keeping the on-device path honest</summary>
          <p>
            The offline breakdown has to produce the same answers as the server,
            which is a real risk when the same logic exists twice. The core math
            is written without OpenCV or database access. It takes plain per-frame
            detections and a homography and returns the same track structure
            the server path produces.
          </p>
          <p>
            That keeps one implementation of the logic that matters and lets the
            browser mirror it, with the OpenCV-dependent parts kept deliberately
            separate.
          </p>
        </details>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="product">
      <h2 class="h-lg sec-title narrow" id="product">The product in use</h2>

      <p class="narrow">
        The public frontend is still useful with its cloud services paused. That
        makes the offline-first claim visible rather than architectural: the
        scouting workspace loads, announces the connection state, and keeps the
        local workflow available.
      </p>

      <div class="product-plates">
        <figure class="reveal">
          <img
            src="/img/frcmob/frcmob-live-scouting-offline.png"
            alt="The FRCMOB live scouting workspace with an offline banner stating that scouting data is saved locally."
            width="1904"
            height="1300"
            loading="lazy"
          />
          <figcaption>
            <span class="mono">Live scouting · offline state</span>
            The capture shows the full tap-first scouting surface while the
            backend is paused. The interface keeps the match form available and
            makes local persistence explicit instead of failing silently.
          </figcaption>
        </figure>

        <figure class="reveal">
          <img
            src="/img/frcmob/frcmob-auto-path-drawer.png"
            alt="The FRCMOB autonomous path editor showing field zones and a curved blue route across the field."
            width="1905"
            height="1397"
            loading="lazy"
          />
          <figcaption>
            <span class="mono">Auto path drawer · spatial evidence</span>
            A scout can record a route against field zones and compare saved
            autonomous paths. It preserves the geometry of what happened instead
            of reducing the run to one score.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="review">
      <h2 class="h-lg sec-title narrow" id="review">Review, not trust</h2>

      <p class="narrow">
        When analysis finishes, the system generates a draft scouting form per
        team rather than a final record. Fields carry per-field confidence and
        are marked ready or low-confidence, so a reviewer knows where to look
        first instead of re-checking everything equally.
      </p>

      <p class="narrow">
        A scout approves the draft, overrides specific fields, or rejects it with
        a reason. Those decisions are kept, and that turns out to be the most
        useful data in the system: override rates per field show where the
        confidence estimates are wrong. If a field is marked high-confidence and
        humans keep correcting it, the confidence formula for that field is
        miscalibrated and gets lowered. If a field is never touched, its
        threshold can go up.
      </p>

      <p class="narrow">
        That loop is what makes automation safe to add here. The system's estimate
        of its own reliability gets measured against what reviewers actually do
        instead of being assumed.
      </p>
    </section>

    <section class="wrap section" aria-labelledby="hard">
      <h2 class="h-lg sec-title narrow" id="hard">What was actually hard</h2>

      <div class="narrow">
        <details class="tech">
          <summary>Ratings that mean something across events</summary>
          <p>
            A raw score doesn't compare across events, because event fields
            differ in strength. Ratings are normalized against the rest of the
            field at that event, with outliers trimmed, and carry a confidence
            derived from how many matches back them.
          </p>
          <p>
            Teams with little video data are anchored with an external prior
            (Statbotics EPA) that's blended out as real match data accumulates,
            so early-event ratings aren't wild guesses dressed up as measurements.
          </p>
        </details>

        <details class="tech">
          <summary>Shipping a model without breaking the one in use</summary>
          <p>
            Model changes are deployed in shadow first: the candidate runs
            alongside the model in production, its predictions are logged, and
            nothing it says reaches a user. After enough coverage the two are
            compared on the same inputs, and promotion is a decision made on that
            comparison.
          </p>
          <p>
            This is why the locked holdout exists. Without a benchmark fixed in
            advance, "the new model seems better" is an easy thing to believe and
            hard to check.
          </p>
        </details>

        <details class="tech">
          <summary>A season-specific game, a system that has to outlive it</summary>
          <p>
            FRC changes its game every year: different scoring, different field,
            different roles. Season-specific rules are isolated into their own
            configuration and game-context layer instead of being spread through
            the analysis code, so a new season is a configuration change plus
            retraining rather than a rewrite.
          </p>
        </details>

        <details class="tech">
          <summary>Degraded runs that announce themselves</summary>
          <p>
            Pipelines fail quietly by default: a missing model file, a bad
            calibration, or a video that wouldn't extract still produces output,
            just wrong output. Runs carry quality signals, and a run that fell
            back to a generic detector or produced too few findings is flagged
            rather than reported as ordinary.
          </p>
        </details>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="status">
      <h2 class="h-lg sec-title narrow" id="status">Status and what's next</h2>

      <div class="narrow">
        <p>
          The platform is in active development and has been through several
          detector generations and a full season of use shaping what it does.
          The parts I'd call solid are the tracking pipeline, the calibration
          workflow with its manual fallback, the review loop, and the promotion
          process for new models.
        </p>

        <p>The open work, in the order I care about it:</p>

        <ul class="next-list" role="list">
          <li>
            <strong>Recall on held-out events.</strong> {(detector.v2.recall * 100).toFixed(0)}%
            is the weakest number in the system. More labeled footage from venues
            and camera angles outside the current training set is the obvious
            lever.
          </li>
          <li>
            <strong>Calibration without taps.</strong> The corner-tap fallback
            works but puts a manual step in front of every clip. Resolving the
            field geometry from the video itself would remove it.
          </li>
          <li>
            <strong>On-device parity.</strong> The browser path handles a useful
            subset of what the server does. Closing that gap makes the offline
            mode a genuine alternative rather than a fallback.
          </li>
          <li>
            <strong>Confidence calibration at scale.</strong> The override-rate
            loop works but needs more reviewed drafts before per-field thresholds
            can be tuned on evidence instead of judgment.
          </li>
        </ul>
      </div>
    </section>

    <nav class="wrap section case-next" aria-label="More work">
      <a href="/work/hardening/" class="next-link">
        <span class="mono">Next case study</span>
        <span class="h-md">Windows Hardening Framework →</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .case-head {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .case-head > .mono {
    margin-bottom: 1.4rem;
  }

  .case-title {
    margin-bottom: 1.5rem;
  }

  .case-lede {
    margin-bottom: 2.5rem;
  }

  .case-meta {
    max-width: 34rem;
    margin-bottom: 1.75rem;
  }

  .case-note {
    max-width: 60ch;
  }

  .case-actions {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem 1rem;
  }

  .case-actions p {
    margin: 0;
    max-width: 42ch;
    line-height: 1.5;
  }

  .case-proof {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .sec-title {
    margin-bottom: 1.5rem;
  }

  .sub-title {
    margin: 2.5rem 0 1rem;
  }

  .detection-plates {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 2.25rem 0 2.75rem;
  }

  .detection-plates figure {
    margin: 0;
    border: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .detection-plates img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 1px solid var(--rule);
  }

  .detection-plates figcaption {
    padding: 1rem;
    color: var(--ink-2);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .detection-plates figcaption .mono {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--accent);
    font-size: 0.58rem;
  }

  .product-plates {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .product-plates figure {
    margin: 0;
    border: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .product-plates img {
    width: 100%;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    object-position: top;
    border-bottom: 1px solid var(--rule);
  }

  .product-plates figcaption {
    padding: 1rem;
    color: var(--ink-2);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .product-plates figcaption .mono {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--accent);
    font-size: 0.58rem;
  }

  .arch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1.75rem;
    margin: 2.25rem 0 2.5rem;
  }

  @media (max-width: 760px) {
    .detection-plates,
    .product-plates {
      grid-template-columns: 1fr;
    }
  }

  .arch-block {
    border-top: 1px solid var(--rule);
    padding-top: 0.9rem;
  }

  .arch-head {
    margin: 0 0 0.75rem;
    color: var(--accent);
  }

  .arch-block ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  .next-list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .next-list li {
    border-left: 2px solid var(--rule);
