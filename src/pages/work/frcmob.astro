---
import Base from "../../layouts/Base.astro";
import FieldTracker from "../../components/FieldTracker.astro";
import Pipeline from "../../components/Pipeline.astro";
import ModelMetrics from "../../components/ModelMetrics.astro";
import RecallGrid from "../../components/RecallGrid.astro";
import SpotTheRobots from "../../components/SpotTheRobots.astro";
import SeasonLog from "../../components/SeasonLog.astro";
import Figure from "../../components/Figure.astro";
import EvidenceStrip from "../../components/EvidenceStrip.astro";
import { projects } from "../../data/projects";
import { detector, pct } from "../../data/model";

const project = projects.find((p) => p.id === "frcmob")!;
const v4 = detector.v4Data;

const visionStages = [
  {
    n: "01",
    title: "Film",
    detail:
      "The scout films the match from the stands, or uploads a clip they already have. Everything after this happens on the phone; the video never has to reach a server.",
  },
  {
    n: "02",
    title: "Calibrate",
    detail:
      "Four taps on the field corners give the image-to-field correspondences, and a homography is fit from them. The calibration frame is stored, and the first recording frame is registered against it, so a phone that moved gets asked to re-calibrate instead of producing quietly wrong positions.",
    note: "AprilTags were the original plan. From the stands they're too small to decode, so taps became the main path.",
  },
  {
    n: "03",
    title: "Detect",
    detail:
      "Detector v4 runs in the browser through ONNX Runtime Web. It reads only the calibrated field area, not the whole frame. Devices with a GPU get the full model on WebGPU; the rest get a nano model on multithreaded WebAssembly.",
    note: `v4 at a ${detector.v4.cutoff} cutoff on WebGPU, v4-nano at ${detector.v4n.cutoff} on WASM. Holdout mAP@50 ${pct(detector.v4.map50)} and ${pct(detector.v4n.map50)}.`,
  },
  {
    n: "04",
    title: "Track",
    detail:
      "Detections are associated in field coordinates rather than pixels, with a speed limit a real robot can't beat, so a camera pan doesn't break a path. Fragments are then stitched conservatively: two pieces join only when the robot reappears soon, close by, and in its own alliance's colour.",
    note: "Stitching rule: reappears within 2 s, within 0.5 m + 2 m/s of where it vanished.",
  },
  {
    n: "05",
    title: "Identify",
    detail:
      "The scout taps once per robot to say which team it is, helped by each team's robot photo and by suggestions that continue a path from where an identified robot was last seen. Suggestions are marked as suggestions; about one in ten is wrong, and the screen says so.",
  },
  {
    n: "06",
    title: "Summarize",
    detail:
      "Identified paths become heat maps, zone time, and an attack-versus-defense split. Accepted runs feed Team Center and the auto-scout drafts that a human reviews.",
  },
];
---

<Base
  title="FRCMOB, Jamal Mammadzada"
  description="A case study on FRCMOB: a full-stack FIRST Robotics scouting platform with team workspaces, offline event packs, match predictions tested without hindsight, and a computer-vision match breakdown that runs on the scout's phone."
  progress={true}
>
  <article>
    <header class="wrap case-head">
      <p class="mono">
        <a href="/work/">Work</a> / Case study {project.index}
      </p>
      <h1 class="h-xl case-title">FRCMOB</h1>
      <p class="lede narrow case-lede">
        Built and deployed for FRC Team 5417, FRCMOB is a full scouting platform:
        team workspaces and live multi-scout rooms, offline event packs, match
        predictions tested without hindsight, and a computer-vision breakdown
        that runs on the scout's own phone.
      </p>

      <dl class="meta-grid case-meta">
        {
          project.meta.map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
        <div>
          <dt>Years</dt>
          <dd>{project.years}</dd>
        </div>
      </dl>

      <p class="note case-note">
        FRCMOB is open source under the GNU AGPL v3. The public repository
        includes the web app, API, game configuration, deployment setup,
        documentation, and tests. Model weights, training data, match recordings,
        database contents, and credentials remain private.
      </p>

      <div class="case-actions">
        <a
          href={project.repoUrl}
          class="btn"
          target="_blank"
          rel="noreferrer"
        >View source on GitHub ↗</a>
        <a
          href="https://scouting-app-iryg.vercel.app/#/home"
          class="btn btn-ghost"
          target="_blank"
          rel="noreferrer"
        >Open the live app ↗</a>
      </div>
    </header>

    <div class="wrap case-proof">
      <EvidenceStrip
        label="FRCMOB evidence"
        items={[
          { value: pct(detector.v4.map50), label: "Holdout mAP@50", detail: `Detector v4 on an unseen event; v2 scored ${pct(detector.v2Rescored.map50)} on the same test` },
          { value: "74.9%", label: "Match calls", detail: "2,507 held-out matches, each predicted from earlier results only" },
          { value: "Competition", label: "Real deployment", detail: "Used by FRC Team 5417" },
          { value: "246", label: "Test files", detail: "94 backend · 152 frontend in the public repository" },
        ]}
      />
    </div>

    <section class="wrap section narrow" aria-labelledby="problem">
      <h2 class="h-lg sec-title" id="problem">The problem</h2>

      <p>
        Alliance selection is the highest-stakes decision a team makes at a
        competition, and it's usually made on thin evidence. The standard method
        is manual scouting: students in the stands watch a match and fill out a
        form. Six robots move at once for two and a half minutes. A scout tracks
        one of them, usually while also trying to count scoring cycles.
      </p>

      <p>
        The data that comes back has predictable problems. Scouts miss things
        when the field gets crowded. Different people apply the same rating scale
        differently, so a "4 out of 5" from one scout doesn't mean what it means
        from another. Coverage is uneven, and the teams you most want data on are
        often the ones nobody was assigned to watch. And by the time you notice a
        gap, that match is over.
      </p>

      <p>
        Video doesn't have those problems. It's complete, it's re-watchable, and
        it's the same every time you look at it. The obstacle is that nobody has
        the hours to watch it. FRCMOB started as an attempt to close that gap:
        process the footage automatically, then put a person in front of the
        result before it counts for anything. It grew into the rest of what a
        scouting team needs around that.
      </p>

      <p>
        I began FRCMOB in February 2026 for{" "}
        <a href="/work/frc5417/">my own team</a>. Team 5417 has since used the
        platform at a real competition. Right now I'm working on running a full
        match breakdown on a real phone at an event, getting the native apps
        into the stores, and getting ready for the 2027 game.
      </p>

      <h3 class="h-md sub-title">The design constraint that shaped everything</h3>

      <p>
        A model that's right most of the time is not automatically useful here. If
        a strategy team can't tell which numbers to trust, a confident wrong
        answer is worse than no answer, because it gets acted on. So the system was built
        so that nothing produced by a model becomes accepted data on its own.
        Every automatic result carries a confidence value, and a human either
        approves it, corrects specific fields, or throws it out. The same rule
        ended up applying to my own numbers: if I can't measure it on data it
        hasn't seen, it doesn't ship.
      </p>
    </section>

    <section class="wrap section" aria-labelledby="season">
      <h2 class="h-lg sec-title narrow" id="season">Season log</h2>

      <p class="narrow">
        Eight months, from a first commit to a platform. The spring was built
        around competitions, with fixes landing during events. The fall was
        about measuring it properly and keeping it running.
      </p>

      <SeasonLog />
    </section>

    <section class="wrap section" aria-labelledby="transform">
      <h2 class="h-lg sec-title narrow" id="transform">Camera space to field space</h2>

      <p class="narrow">
        Everything spatial depends on one transform. A camera in the stands
        produces a foreshortened image where the far end of the field is
        compressed into a fraction of the frame. Strategy questions are about
        real positions. The homography is what connects the two, and if it's
        wrong every downstream metric is wrong with it.
      </p>

      <FieldTracker />
    </section>

    <section class="wrap section" aria-labelledby="pipeline">
      <h2 class="h-lg sec-title narrow" id="pipeline">The vision pipeline</h2>

      <p class="narrow">
        Six stages take a scout's video to identified robot paths, and all six
        run on the phone. Select a stage to read what it does.
      </p>

      <Pipeline
        id="vision-pipeline"
        label="Phone video → identified paths"
        stages={visionStages}
      />

      <div class="narrow">
        <details class="tech">
          <summary>Why the AprilTag fallback exists</summary>
          <p>
            On paper, calibration is automatic: detect the fiducials, solve for
            the matrix, done. Testing on real footage showed the tags are
            frequently unresolvable at the distance and angle a phone in the
            stands actually films from. There are too few pixels on the tag to decode.
          </p>
          <p>
            The fallback asks the scout to tap the four field corners once. That
            gives the same four correspondences without needing to read a single
            tag. It's a worse method in principle and the only one that works
            from row 20, which is why it's now the main path rather than the
            backup.
          </p>
        </details>

        <details class="tech">
          <summary>Reading team numbers off bumpers (tried, abandoned)</summary>
          <p>
            Tracking gives continuous paths, but not which team a path belongs
            to. The first answer was OCR on bumper numbers, with reads voted on
            across a whole track and matched against the six teams the schedule
            says are on the field. The closed answer set made it look tractable.
          </p>
          <p>
            It wasn't. On broadcast frames the bumper text is a handful of
            pixels tall, and no amount of voting recovers digits that were never
            resolved. Identity is now one tap per robot by the scout, helped by
            robot photos and path suggestions, and OCR is gone from the system.
          </p>
        </details>
      </div>
    </section>

    <section class="wrap section narrow" aria-labelledby="pivot">
      <h2 class="h-lg sec-title" id="pivot">The pivot: why broadcast video lost</h2>

      <p>
        For most of the project the vision pipeline ran on the server, against
        event broadcasts. It would download the stream, calibrate automatically
        from the field's AprilTags, track every robot, and read bumper numbers.
        On September 25 it ran end to end in production for the first time.
      </p>

      <p>
        Then I checked the output by eye. On the best Championship feed, 6 of
        the 15 tracks it had identified mixed up two robots from the same
        alliance. Each robot was also only covered for a fraction of the
        match. Every 2026 broadcast is split-screen, so robots are small and
        bumper text is smaller still. Nothing downstream could fix that. The
        information wasn't in the pixels.
      </p>

      <p>
        So on September 28 I retired it: stream extraction, server-side
        tracking, bumper OCR, broadcast calibration, and the worker container
        that ran them. Vision moved onto the scout's phone, filmed from the
        stands where robots are bigger and a person can say which is which.
        The server image went from about 11 GB to 1.65 GB.
      </p>

      <p>
        It was the right call and an uncomfortable one. That pipeline was months
        of work, and it did run. It just didn't produce data I'd let a strategy
        team act on.
      </p>
    </section>

    <section class="wrap section" aria-labelledby="model">
      <h2 class="h-lg sec-title narrow" id="model">Training the detector</h2>

      <p class="narrow">
        General-purpose detectors barely register competition robots. They aren't
        in the training distribution of a model trained on everyday objects.
        The detector here is single-class, trained on match footage. The early
        versions learned from{" "}
        {detector.trainImages.toLocaleString()} labeled frames with a reviewed
        subset of {detector.reviewedImages.toLocaleString()} images.
      </p>

      <div class="detection-plates reveal" aria-label="Examples from the reviewed Roboflow dataset">
        <figure>
          <img
            src="/img/frcmob/roboflow-detections-wide.png"
            alt="A FIRST Robotics broadcast frame with three robots marked by lime detection boxes across a foreshortened field."
            width="1280"
            height="720"
            loading="lazy"
          />
          <figcaption>
            <span class="mono">Reviewed frame · 03 detections</span>
            A relatively clean broadcast view. Even here, the robots occupy only
            a small fraction of the frame and the sponsor panel obscures the
            center foreground.
          </figcaption>
        </figure>
        <figure>
          <img
            src="/img/frcmob/roboflow-detections-dense.png"
            alt="A crowded FIRST Robotics broadcast frame with robots marked by detection boxes across the main view and two picture-in-picture views."
            width="1280"
            height="720"
            loading="lazy"
          />
          <figcaption>
            <span class="mono">Reviewed frame · crowded field</span>
            The harder case: robots cross, shrink into the far field, and appear
            again in picture-in-picture views. These are annotations from the
            real-broadcast dataset, not a staged visualization.
          </figcaption>
        </figure>
      </div>

      <ModelMetrics />

      <div class="narrow">
        <p>
          The v1 run scored {pct(detector.v1.map50)} mAP@50 on its validation
          split, which sounds finished and isn't. That split is drawn from the
          same events, the same venues, and often the same matches as the
          training data. It measures whether the model learned the frames it
          was shown. It says very little about a competition it has never seen.
        </p>

        <p>
          So one full event, {detector.holdoutEvent}, was held out entirely and
          locked as a benchmark. Against that, the same model scored
          {" "}{pct(detector.v1HoldoutMap50)}. That drop is the real
          measurement, and it's the one that governs whether a new model ships.
          v2 was promoted because it reached {pct(detector.v2.map50)} on that
          locked holdout, not because its loss curves looked better.
        </p>
      </div>

      <RecallGrid />

      <div class="narrow">
        <p>
          Before reading why recall stalled, try the job the labels were meant
          to do. These are real frames from the training data.
        </p>
      </div>

      <SpotTheRobots />

      <div class="narrow">
        <h3 class="h-md sub-title" id="v4">Detector v4: the labels were the bug</h3>

        <p>
          After v2, recall wouldn't move. Dropping the confidence threshold to
          almost nothing still left it around half, which is what you'd expect
          if the model believed some robots were background. It did, because
          that's what it had been taught.
        </p>

        <p>
          An audit of the training labels found they boxed about{" "}
          {v4.oldBoxesPerFrame} robots per frame, when a typical frame actually
          holds about {v4.robotsPerFrame}. Every robot left unboxed was a
          lesson that robots look like background. More training on those
          labels would only have taught it more firmly.
        </p>

        <p>
          The fix was to train only on frames whose labels were already
          near-complete: {v4.train} for training and {v4.val} for validation,
          plus {v4.addedByEye} missing robots I confirmed by eye. Model
          proposals were never auto-accepted, because at high confidence only
          about 40% of them were real robots. Four training runs on one rented
          A100 took {v4.gpuHours} and cost {v4.cost}, and the instance shut
          itself down when they finished.
        </p>

        <p>
          On the same locked holdout, with both models re-measured at full
          1280-pixel resolution (which is why v2 reads slightly differently
          here than above), mAP@50 went from
          {" "}{pct(detector.v2Rescored.map50)} to {pct(detector.v4.map50)} and
          recall from {Math.round(detector.v2Rescored.recall * 100)}% to
          {" "}{Math.round(detector.v4.recall * 100)}%. On real stands footage it
          now finds 3.95 robots per frame, against 2.8 to 3.2 before.
        </p>

        <details class="tech">
          <summary>Precision {Math.round(detector.v4.precision * 100)}%, recall {Math.round(detector.v4.recall * 100)}%, and why that tradeoff is still the right one</summary>
          <p>
            On the holdout, v4 is precise and still somewhat conservative: when
            it calls something a robot it's almost always right, and it misses
            about a third of the ones it isn't sure about. For this system
            that's the correct direction to err.
          </p>
          <p>
            A missed detection is a gap the tracker can bridge and the scout can
            see. A false detection is a phantom robot with a path, a zone
            history, and a heat map attributed to a real team. That noise
            propagates and looks exactly like real data. Recall went up because
            the labels got fixed, not because precision was traded away for it.
          </p>
        </details>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="phone">
      <h2 class="h-lg sec-title narrow" id="phone">Running a neural network on a phone</h2>

      <p class="narrow">
        Moving vision onto the phone only works if a full match finishes before
        the next one starts. The first version took about seven minutes on a
        CPU. It now takes well under one.
      </p>

      <EvidenceStrip
        label="On-device breakdown speed"
        items={[
          { value: "33 s", label: "Full match, GPU", detail: "Chrome with WebGPU, full-size v4" },
          { value: "55 s", label: "Full match, CPU", detail: "WebKit, Safari's engine, v4-nano" },
          { value: "~7 min", label: "Where it started", detail: "Same match in WebKit before the work below" },
        ]}
      />

      <div class="narrow">
        <p>Four changes did most of it:</p>

        <ul class="next-list" role="list">
          <li>
            <strong>Read only the field.</strong> A stands view is a thin strip,
            so a square model input was mostly padding. The detector now reads
            just the calibrated field area, which is about twice as fast and
            finds more robots because they're bigger in the input.
          </li>
          <li>
            <strong>Use every core.</strong> WebAssembly can run on several
            threads, but only on a page with stricter browser isolation. The
            recorder runs on its own isolated page, so the rest of the app can
            keep embedding match videos.
          </li>
          <li>
            <strong>Decode, don't play.</strong> Frames used to come from
            playing the video in real time. WebCodecs now decodes them straight
            from the file, which took an uploaded match from 85 s to 33 s on a
            GPU.
          </li>
          <li>
            <strong>Pick the engine per device.</strong> WebGPU gets the
            full-size model. CPU devices get the nano model, which in WebKit
            takes 82 ms a frame against 243 ms for the full one.
          </li>
        </ul>

        <p>
          These are measured on a laptop in Chrome and in WebKit, the engine
          Safari and every iPhone browser use. A full run on a real phone at a
          real event is the next test, and I'll say so until it's done.
        </p>

        <h3 class="h-md sub-title">Who is that robot?</h3>

        <p>
          Detection says where robots are. The scout says who they are, and the
          goal is to ask as little as possible. To measure that, I labelled
          one match by hand from its 1080p upload: bumper numbers, each robot's
          look, and elimination within a frame.
        </p>

        <p>
          Against those labels, conservative stitching cut one match from 126
          path fragments to 81, with 95.7% of hand labels landing on the right
          team. Looser rules made fewer fragments and much worse identity, so
          they didn't ship. Path suggestions then cut the scout's taps from 81
          to 48. The trade is that about one suggestion in ten is wrong, and the
          screen says that rather than hiding it.
        </p>

        <details class="tech">
          <summary>The run that said "done" at 89 seconds</summary>
          <p>
            Under detection load, WebKit silently drops a video's source every
            couple of minutes. The stall watchdog read that as the end of the
            match, so a breakdown covering only the first 89 seconds was
            reported as complete, with 66 paths and no warning.
          </p>
          <p>
            The recorder now reopens the file and resumes from the last frame
            it processed, and if the video keeps failing it says how far it
            got. A silent partial result is the worst kind, because it looks
            like a finished one.
          </p>
        </details>
      </div>
    </section>

    <section class="wrap section narrow" aria-labelledby="predictions">
      <h2 class="h-lg sec-title" id="predictions">Predicting matches without hindsight</h2>

      <p>
        FRCMOB predicts who wins each match, and every page that shows a win
        probability shows the same one. Getting that number right meant first
        admitting a wrong one.
      </p>

      <p>
        The machine-learning model I'd built scored 82% in training. Tested
        properly, rating each team only from events it had already played, it
        scored 49.8%. That's a coin flip, and worse than the plain formula's
        59.2%. The 82% was leakage: the end-of-event ratings it learned from
        already contained the matches it was predicting.
      </p>

      <p>
        The fix was an as-of replay. For each match, the database is rewound
        to what was known before it, and only that is used to predict it. Run
        over the 56 newest events of the 2026 season, it scored every candidate
        on exactly the same replay.
      </p>

      <div class="ledger-wrap">
        <table class="ledger">
          <caption class="mono">2,507 held-out matches · each predicted from earlier results only</caption>
          <thead>
            <tr><th scope="col">Predictor</th><th scope="col">Accuracy</th><th scope="col">Brier</th></tr>
          </thead>
          <tbody>
            <tr class="is-shipped"><th scope="row">Fuel rate, shrunk toward last event (shipped)</th><td>74.9%</td><td>0.173</td></tr>
            <tr><th scope="row">Rating formula, as-of inputs</th><td>69.2%</td><td>0.195</td></tr>
            <tr class="is-leaky"><th scope="row">Rating formula, end-of-event inputs (leaky)</th><td>81.5%</td><td>0.141</td></tr>
          </tbody>
        </table>
      </div>

      <p>
        The shipped predictor is simple. Each team's official fuel rate from
        its earlier matches at the event is shrunk toward its rate at its
        previous event, harder when it has played fewer matches. The alliance
        sums are compared and turned into a probability with one scale factor,
        fitted on over 15,000 matches from older events. Teams with no fuel
        history fall back to the rating formula.
      </p>

      <p>
        The lesson is the last row of that table. Fed inputs computed after
        the matches, even the simple formula looked like 81.5%, and on the first
        round of each event, before any result existed, it scored 82%. With
        those inputs removed, that same round fell to a coin flip. Every
        evaluation now cuts post-match data off first, and the ML stays switched
        off in production until it beats the formula on the same replay.
      </p>
    </section>

    <section class="wrap section" aria-labelledby="product">
      <h2 class="h-lg sec-title narrow" id="product">Built for real teams</h2>

      <p class="narrow">
        The vision work gets the attention, but most of what a team touches at
        an event is everything around it. Venue wifi fails, scouts swap phones,
        and a lead needs to know who is watching which robot.
      </p>

      <div class="arch-grid">
        <div class="arch-block reveal">
          <p class="mono arch-head">Team workspaces</p>
          <ul role="list">
            <li>Join with a 10-character code, stored only as a hash</li>
            <li>Picklists, pit notes and rooms stay private to the team</li>
            <li>Removing a member takes effect on every request</li>
          </ul>
        </div>
        <div class="arch-block reveal">
          <p class="mono arch-head">Team scouting rooms</p>
          <ul role="list">
            <li>One room per team per event</li>
            <li>The lead assigns scouts to robots, match by match, saved atomically</li>
            <li>Live sync over WebSockets and Redis, about 0.8 s phone to phone</li>
          </ul>
        </div>
        <div class="arch-block reveal">
          <p class="mono arch-head">Offline at events</p>
          <ul role="list">
            <li>"Ready for no signal": schedules, ratings, predictions and team pages saved ahead</li>
            <li>Edits queue offline and replay in order</li>
            <li>"Synced with your team" confirms delivery</li>
          </ul>
        </div>
        <div class="arch-block reveal">
          <p class="mono arch-head">The rest</p>
          <ul role="list">
            <li>Match alerts, Match Center with live scores</li>
            <li>Picklists with a live alliance-selection mode</li>
            <li>Pit scouting, strategy briefings, Alliance Advisor</li>
          </ul>
        </div>
      </div>

      <p class="narrow">
        There are also native iOS and Android apps, built with Capacitor, that
        keep their sign-in tokens in the Keychain and Keystore. They're built
        and tested, not in the stores yet.
      </p>

      <div class="product-plates">
        <figure class="reveal">
          <img
            src="/img/frcmob/frcmob-live-scouting-offline.png"
            alt="The FRCMOB live scouting workspace with an offline banner stating that scouting data is saved locally."
            width="1904"
            height="1300"
            loading="lazy"
          />
          <figcaption>
            <span class="mono">Live scouting · offline state</span>
            The full tap-first scouting surface with no connection. The match
            form stays available and the banner makes local saving explicit
            instead of failing silently.
          </figcaption>
        </figure>

        <figure class="reveal">
          <img
            src="/img/frcmob/frcmob-auto-path-drawer.png"
            alt="The FRCMOB autonomous path editor showing field zones and a curved blue route across the field."
            width="1905"
            height="1397"
            loading="lazy"
          />
          <figcaption>
            <span class="mono">Auto path drawer · spatial evidence</span>
            A scout can record a route against field zones and compare saved
            autonomous paths. It preserves the geometry of what happened instead
            of reducing the run to one score.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="arch">
      <h2 class="h-lg sec-title narrow" id="arch">System architecture</h2>

      <p class="narrow">
        Once the video work moved onto phones, the server stopped needing to be
        big. It needs to be close to its database, fast on venue connections,
        and cheap enough to leave running all season.
      </p>

      <div class="arch-grid">
        {
          project.stack.map((group) => (
            <div class="arch-block reveal">
              <p class="mono arch-head">{group.group}</p>
              <ul role="list">
                {group.items.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          ))
        }
      </div>

      <Figure
        src="/img/jamal-oracle.jpg"
        alt="Jamal at a workbench in the robotics lab with a laptop open to a terminal session on the deployment server."
        label="Plate 01"
        caption="Working on the Oracle Cloud deployment that runs the backend. The screen is deliberately obscured here; it was an SSH session into the deployment host."
        width={1500}
        height={1042}
      />

      <div class="narrow">
        <p>
          The whole backend runs on one free Oracle Cloud VM, with 4 cores and
          24 GB of memory, for $0 a month. On it are the FastAPI app, Postgres 17,
          Redis 7, and Caddy for HTTPS. There's no separate worker any more. The
          React and TypeScript frontend is on Vercel with edge caching in front of
          the API, and an hourly off-site backup goes to Neon.
        </p>

        <p>
          The frontend is built offline-first. Scouts lose connectivity
          constantly in a venue, so submissions queue locally and sync when the
          network comes back rather than failing.
        </p>

        <details class="tech">
          <summary>Keeping the phone and the server in agreement</summary>
          <p>
            The phone's breakdown has to agree with what the server does with
            it afterwards, which is a real risk when similar logic exists in two
            languages. The tracking and stitching code is benchmarked against a
            hand-labelled match, so a change that makes paths look tidier but
            puts robots on the wrong team fails a number rather than slipping
            through.
          </p>
        </details>
      </div>
    </section>

    <section class="wrap section narrow" aria-labelledby="prod">
      <h2 class="h-lg sec-title" id="prod">Running it in production</h2>

      <p>
        The backend had been off since April. On September 24 I brought it back
        on the free VM, and most of what followed was learning what only breaks
        for real.
      </p>

      <p>
        <strong>Distance was the slow part.</strong> The database and Redis were
        managed services in another region, so every query paid a long round
        trip. Moving both onto the VM took a schedule request from 911 ms to 18 ms
        and event ratings from 784 ms to 36 ms.
      </p>

      <details class="tech">
        <summary>The backup that broke the app</summary>
        <p>
          A database backup taken through Neon's connection pooler changed a
          session setting, and the pooler handed that broken setting to the
          app's own connections. The app couldn't find its tables until it was
          fixed. The backup script now refuses to run against the pooler at all.
        </p>
      </details>

      <details class="tech">
        <summary>Room bugs that only real two-phone tests found</summary>
        <p>
          Production runs two server processes; my laptop ran one. Joining a
          room and opening its live connection could land on different
          processes, and when they did, the connection was refused as a
          duplicate scout. The fix clears a scout's presence in Redis, which
          both processes share, and a new test runs two hubs against one
          shared store to prove it.
        </p>
        <p>
          The same tests found a second one: reopening a room from another
          device within 30 seconds was rejected as a duplicate, 12 times out of
          12. The check behind it predated team workspaces, when scouts picked
          their own names. Since workspaces, it could only ever match the same
          person, so it was removed.
        </p>
      </details>

      <details class="tech">
        <summary>Speed work</summary>
        <ul class="tight-list">
          <li>Home went from 31 requests to 9.</li>
          <li>Edge caching turned a 0.81 s miss into a 0.18 s hit.</li>
          <li>One slow endpoint went from 2.9 s to 10 ms.</li>
          <li>Real-user speed timings are now collected, so the next round starts from data.</li>
        </ul>
      </details>

      <details class="tech">
        <summary>Cleanup from production logs</summary>
        <p>
          One scheduled job re-downloaded the same data every 3 hours and
          rewrote the same 1,662 rows. Another rebuilt pages for finished events
          every 2 minutes, for 60 to 100 seconds a run, which kept about half a
          server process busy for data that couldn't change. The first is gone;
          the second now only rebuilds events that are in play.
        </p>
        <p>
          A full re-ingest of the 2026 season finished 299 of 299 events with
          no failures, unattended.
        </p>
      </details>
    </section>

    <section class="wrap section narrow" aria-labelledby="quality">
      <h2 class="h-lg sec-title" id="quality">Quality checks that run themselves</h2>

      <p>
        Eight browser guards sweep the app and fail on colours outside the
        palette, off-scale type sizes, weak contrast, overflow, missing
        affordances, and pages in one section that don't look like each other.
      </p>

      <p>
        The consistency guard only ran at desktop width, so drift that showed up
        only on phones passed it. I extended it to phone width and checked that
        it fails on the old code before trusting it on the new. Under the guards
        sit about 1,400 automated tests across the backend and frontend.
      </p>
    </section>

    <section class="wrap section" aria-labelledby="review">
      <h2 class="h-lg sec-title narrow" id="review">Review, not trust</h2>

      <p class="narrow">
        When analysis finishes, the system generates a draft scouting form per
        team rather than a final record. Fields carry per-field confidence and
        are marked ready or low-confidence, so a reviewer knows where to look
        first instead of re-checking everything equally.
      </p>

      <p class="narrow">
        A scout approves the draft, overrides specific fields, or rejects it with
        a reason, and those decisions are kept. The plan is to use override
        rates per field to check the confidence estimates: a field marked
        high-confidence that humans keep correcting is miscalibrated, and a field
        nobody touches can have its threshold raised.
      </p>

      <p class="narrow">
        That calibration hasn't run yet. There aren't enough reviewed drafts to
        tune anything on evidence, so for now the thresholds are judgment, and
        I'd rather say that than imply a loop that hasn't closed.
      </p>
    </section>

    <section class="wrap section" aria-labelledby="hard">
      <h2 class="h-lg sec-title narrow" id="hard">What was actually hard</h2>

      <div class="narrow">
        <details class="tech">
          <summary>Ratings that mean something across events</summary>
          <p>
            A raw score doesn't compare across events, because event fields
            differ in strength. Ratings are normalized against the rest of the
            field at that event, with outliers trimmed, and carry a confidence
            derived from how many matches back them.
          </p>
          <p>
            Teams with little match data are anchored with an external prior
            that's blended out as real data accumulates, so early-event ratings
            aren't wild guesses dressed up as measurements.
          </p>
        </details>

        <details class="tech">
          <summary>Shipping a model without breaking the one in use</summary>
          <p>
            Model changes are deployed in shadow first: the candidate runs
            alongside what's in production, its predictions are logged, and
            nothing it says reaches a user. Promotion is a decision made on a
            fixed comparison, not on a feeling.
          </p>
          <p>
            That process did its job. The match-outcome model is switched off
            in production because it lost a fair test to a simpler formula,
            as described in{" "}
            <a href="#predictions">predicting matches without hindsight</a>. Without a
            benchmark fixed in advance, "the new model seems better" is an easy
            thing to believe and hard to check.
          </p>
        </details>

        <details class="tech">
          <summary>A season-specific game, a system that has to outlive it</summary>
          <p>
            FRC changes its game every year: different scoring, different field,
            different roles. Season-specific rules are isolated into their own
            configuration and game-context layer instead of being spread through
            the analysis code, so a new season is a configuration change plus
            retraining rather than a rewrite. The system refuses to run on a
            season it doesn't know rather than guessing.
          </p>
        </details>

        <details class="tech">
          <summary>Degraded runs that announce themselves</summary>
          <p>
            Pipelines fail quietly by default: a bad calibration, a video that
            stopped halfway, or a model that didn't load still produces output,
            just wrong output. Runs carry quality signals, and a run that is
            partial or produced too few findings says so rather than being
            reported as ordinary.
          </p>
        </details>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="status">
      <h2 class="h-lg sec-title narrow" id="status">Status and what's next</h2>

      <div class="narrow">
        <p>
          The backend has been live since September. Recall is up, and the
          on-device breakdown is now the main path, not a fallback. The parts
          I'd call solid are the as-of evaluation setup for both the detector
          and the predictor, team rooms and offline sync, and the production
          deployment.
        </p>

        <p>The open work, in the order I care about it:</p>

        <ul class="next-list" role="list">
          <li>
            <strong>A full match on a real phone at a real event.</strong> So
            far the on-device numbers come from desktop browsers and emulated
            phones.
          </li>
          <li>
            <strong>Native apps in the stores.</strong> Signing, push
            notifications, and App Store and Play Store setup.
          </li>
          <li>
            <strong>Optional sign-in by email code.</strong> Designed and built,
            switched off until there's a domain to send from.
          </li>
          <li>
            <strong>2027 season readiness.</strong> The system already refuses
            to run on unknown seasons. A new game needs its rules, its scoring,
            and a detector retrain.
          </li>
          <li>
            <strong>ML that earns its place.</strong> A model using only
            pre-match features reached 72.6% in testing, but it isn't switched
            on. It goes live when it beats the shipped formula on the same
            as-of replay, not before.
          </li>
        </ul>
      </div>
    </section>

    <nav class="wrap section case-next" aria-label="More work">
      <a href="/work/hardening/" class="next-link">
        <span class="mono">Next case study</span>
        <span class="h-md">Windows Hardening Framework →</span>
      </a>
    </nav>
  </article>
</Base>

