---
/**
 * Work index — a two-pane explorer, not a stacked list.
 *
 * Left rail is the index; the right pane is a single detail surface that swaps
 * as you move through it. Selection is driven by hover on fine pointers and by
 * click/focus everywhere, so it works on touch and by keyboard. On narrow
 * screens the two panes collapse into one flow and every detail panel is shown.
 */
import Base from "../../layouts/Base.astro";
import { projects, allTags } from "../../data/projects";
---

<Base
  title="Work, Jamal Mammadzada"
  description="Projects by Jamal Mammadzada: a computer-vision scouting platform, a Windows hardening framework, educational robot kits, and a cryptography course."
>
  <div class="explorer" data-explorer>
    <!-- Left: the index -->
    <div class="rail">
      <div class="rail-top">
        <p class="mono">Work · {projects.length} systems</p>
        <h1 class="rail-title">Pick one.</h1>
      </div>

      <div class="filter-row" role="group" aria-label="Filter projects by area">
        <button type="button" class="chip is-on" data-filter="all" aria-pressed="true">All</button>
        {allTags.map((t) => (
          <button type="button" class="chip" data-filter={t} aria-pressed="false">{t}</button>
        ))}
      </div>

      <ul class="index" role="list">
        {projects.map((p, i) => (
          <li data-row data-tags={p.tags.join("|")}>
            <button
              type="button"
              class:list={["row", { "is-on": i === 0 }]}
              data-target={p.id}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              <span class="row-n mono">{p.index}</span>
              <span class="row-body">
                <span class="row-title">{p.title}</span>
                <span class="row-kind mono">{p.kind}</span>
              </span>
              <span class="row-year mono">{p.years.split("–")[0].trim()}</span>
            </button>
          </li>
        ))}
      </ul>

      <p class="empty mono" id="empty" hidden>Nothing matches that filter.</p>
    </div>

    <!-- Right: the detail surface -->
    <div class="stage">
      {projects.map((p, i) => (
        <article
          class:list={["panel", { "is-on": i === 0 }]}
          data-panel={p.id}
          data-tags={p.tags.join("|")}
          aria-hidden={i === 0 ? "false" : "true"}
        >
          <div class="panel-head">
            <p class="mono panel-ix">{p.index} / {String(projects.length).padStart(2, "0")}</p>
            <p class="mono panel-years">{p.years}</p>
          </div>

          <h2 class="panel-title">{p.title}</h2>
          <p class="panel-kind mono">{p.kind}</p>
          <p class="panel-blurb">{p.blurb}</p>

          <dl class="panel-meta">
            {p.meta.slice(0, 3).map((m) => (
              <div><dt class="mono">{m.label}</dt><dd>{m.value}</dd></div>
            ))}
          </dl>

          <ul class="panel-stack" role="list">
            {p.stack.slice(0, 2).map((g) => (
              <li>
                <span class="mono stack-g">{g.group}</span>
                <span class="stack-i">{g.items.slice(0, 5).join(" · ")}</span>
              </li>
            ))}
          </ul>

          <div class="panel-acts">
            {p.href && <a href={p.href} class="btn">Read the case study</a>}
            {p.repoUrl && <a href={p.repoUrl} class="btn btn-ghost" rel="noopener">Source</a>}
            {p.privateRepo && <span class="mono panel-private">Source private</span>}
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>

<style>
  /* Full-bleed: the explorer escapes the page container entirely, which is the
     point — it should not read as another centred section. */
  .explorer {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    border-top: 1px solid var(--rule);
    min-height: calc(100vh - 4.25rem);
  }

  /* -- left rail -- */
  .rail {
    border-right: 1px solid var(--rule);
    padding: clamp(1.5rem, 3vw, 2.6rem) clamp(1.25rem, 3vw, 2.4rem)
      clamp(2rem, 4vw, 3rem) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .rail-title {
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
    letter-spacing: -0.03em;
    margin-top: 0.5rem;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .chip {
    font-family: var(--mono);
    font-size: var(--fs-label);
    letter-spacing: 0.05em;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink-3);
    cursor: pointer;
    border-radius: var(--radius);
  }

  .chip:hover { color: var(--ink); border-color: var(--rule-2); }

  .chip.is-on {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .row {
    width: 100%;
    display: grid;
    grid-template-columns: 2.1rem 1fr auto;
    gap: 0.9rem;
    align-items: baseline;
    text-align: left;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--rule);
    padding: 0.85rem 0.6rem 0.9rem 0;
    cursor: pointer;
    color: inherit;
    font: inherit;
    /* The accent bar slides in from the left on selection. */
    box-shadow: inset 0 0 0 0 var(--accent);
    transition: box-shadow 0.16s ease, background 0.16s ease, padding 0.16s ease;
  }

  .row:hover { background: var(--accent-wash); }

  .row.is-on {
    background: var(--accent-wash);
    box-shadow: inset 3px 0 0 0 var(--accent);
    padding-left: 0.7rem;
  }

  .row-n { font-size: var(--fs-label); }
  .row.is-on .row-n { color: var(--accent); }

  .row-body { display: block; min-width: 0; }

  .row-title {
    display: block;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .row-kind {
    display: block;
    font-size: var(--fs-label);
    margin-top: 0.15rem;
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .row-year { font-size: var(--fs-label); }

  /* -- right stage -- */
  .stage {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.6rem) var(--gutter) clamp(2rem, 4vw, 3rem)
      clamp(1.5rem, 3vw, 2.6rem);
  }

  .panel {
    /* Panels are stacked in the same grid cell and cross-faded, so the pane
       height is set by the tallest one and nothing jumps on switch. */
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
    max-width: 60ch;
  }

  .panel.is-on { opacity: 1; visibility: visible; transform: none; }

  .stage { display: grid; align-content: start; }

  .panel-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--rule);
  }

  .panel-ix { color: var(--accent); }

  .panel-title {
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    letter-spacing: -0.032em;
    margin-top: 1.1rem;
  }

  .panel-kind {
    margin: 0.5rem 0 0;
    text-transform: none;
    letter-spacing: 0.05em;
    font-size: var(--fs-label);
  }

  .panel-blurb {
    margin: 1.25rem 0 0;
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.62;
  }

  .panel-meta {
    margin: 1.6rem 0 0;
    border-top: 1px solid var(--rule);
  }

  .panel-meta > div {
    display: grid;
    grid-template-columns: minmax(6.5rem, 24%) 1fr;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: var(--fs-ui);
  }

  .panel-meta dt {
    font-size: var(--fs-label);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-top: 0.15rem;
  }

  .panel-meta dd { margin: 0; color: var(--ink-2); }

  .panel-stack {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .stack-g {
    display: block;
    font-size: var(--fs-label);
    color: var(--accent);
  }

  .stack-i { font-size: var(--fs-sm); color: var(--ink-2); }

  .panel-acts {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 1.9rem;
  }

  .panel-private { font-size: var(--fs-label); }

  .empty { padding-top: 1rem; }

  /* -- collapse to one flow -- */
  @media (max-width: 900px) {
    .explorer { grid-template-columns: 1fr; min-height: 0; }

    .rail {
      border-right: 0;
      padding-inline: var(--gutter);
    }

    .stage {
      display: block;
      padding-inline: var(--gutter);
      border-top: 1px solid var(--rule);
    }

    /* Without a persistent pane, showing one panel at a time hides content
       behind an interaction. Every panel is visible instead. */
    .panel {
      opacity: 1;
      visibility: visible;
      transform: none;
      max-width: none;
      padding-block: 2rem;
      border-bottom: 1px solid var(--rule);
    }

    .index { display: none; }
    .row { display: none; }
  }
</style>

<script>
  const host = document.querySelector<HTMLElement>("[data-explorer]");

  if (host) {
    const rows = Array.from(host.querySelectorAll<HTMLButtonElement>(".row"));
    const panels = Array.from(host.querySelectorAll<HTMLElement>("[data-panel]"));
    const filters = Array.from(host.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const items = Array.from(host.querySelectorAll<HTMLElement>("[data-row]"));
    const empty = document.getElementById("empty");
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)");

    const select = (id: string) => {
      rows.forEach((r) => {
        const on = r.dataset.target === id;
        r.classList.toggle("is-on", on);
        r.setAttribute("aria-pressed", String(on));
      });
      panels.forEach((p) => {
        const on = p.dataset.panel === id;
        p.classList.toggle("is-on", on);
        p.setAttribute("aria-hidden", String(!on));
      });
    };

    rows.forEach((r) => {
      const id = r.dataset.target!;
      r.addEventListener("click", () => select(id));
      r.addEventListener("focus", () => select(id));
      // Hovering swaps the pane only where a real cursor exists; on touch the
      // click handler is the only path, so nothing changes under the finger.
      r.addEventListener("mouseenter", () => {
        if (fine.matches) select(id);
      });
    });

    filters.forEach((btn) => {
      btn.addEventListener("click", () => {
        const want = btn.dataset.filter!;

        filters.forEach((b) => {
          const on = b === btn;
          b.classList.toggle("is-on", on);
          b.setAttribute("aria-pressed", String(on));
        });

        let shown: HTMLElement | null = null;
        let count = 0;

        items.forEach((li) => {
          const tags = (li.dataset.tags ?? "").split("|");
          const match = want === "all" || tags.includes(want);
          li.hidden = !match;
          if (match) {
            count += 1;
            if (!shown) shown = li;
          }
        });

        panels.forEach((panel) => {
          const tags = (panel.dataset.tags ?? "").split("|");
          panel.hidden = !(want === "all" || tags.includes(want));
        });

        if (empty) empty.hidden = count > 0;

        // Keep the pane in sync: if the selected project was filtered out,
        // fall through to the first one still visible.
        const current = rows.find((r) => r.classList.contains("is-on"));
        const stillVisible = current && !current.closest("[data-row]")!.hidden;
        if (!stillVisible && shown) {
          const btn2 = (shown as HTMLElement).querySelector<HTMLButtonElement>(".row");
          if (btn2) select(btn2.dataset.target!);
        }
      });
    });
  }
</script>
