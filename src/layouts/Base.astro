---
import "../styles/global.css";
import { site, nav } from "../data/site";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title: string;
  description?: string;
  /** Adds a thin reading-progress bar; used on long case studies. */
  progress?: boolean;
}

const { title, description = site.description, progress = false } = Astro.props;
const pathname = Astro.url.pathname;
const origin = Astro.site ?? new URL("https://example.com");
const ogImage = new URL("/og.png", origin).href;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={new URL(pathname, origin)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(pathname, origin).href} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
    />
    <!-- Set the theme before first paint so there is no flash. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "dark" || t === "light") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>

    {progress && <div class="progress" id="progress" aria-hidden="true"></div>}

    <header class="site-head">
      <div class="wrap head-inner">
        <a href="/" class="wordmark" aria-label={`${site.name}, home`}>
          <span class="wordmark-name">Jamal Mammadzada</span>
          <span class="wordmark-sub mono">Allen, TX</span>
        </a>

        <nav class="site-nav" aria-label="Primary">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={["nav-link", { current: isActive(item.href) }]}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-inner">
        <div>
          <p class="mono">Contact</p>
          <p>
            <a href={`mailto:${site.email}`}>{site.email}</a><br />
            <a href={site.githubUrl} rel="me noopener">github.com/{site.github}</a><br />
            <span class="dim">{site.location}</span>
          </p>
        </div>
        <div>
          <p class="mono">Pages</p>
          <ul class="foot-list">
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            <li><a href={site.resume}>Résumé (PDF)</a></li>
          </ul>
        </div>
        <div class="foot-end">
          <p class="mono">{site.school} · Class of 2027</p>
          <p class="dim foot-fine">
            Built with Astro. No analytics, no trackers, no cookies.
          </p>
        </div>
      </div>
    </footer>

    <script>
      // Reveal-on-scroll. Skipped entirely when the user prefers reduced motion.
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
      const targets = document.querySelectorAll<HTMLElement>(".reveal");

      if (reduce.matches) {
        targets.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("in");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        );
        targets.forEach((el) => io.observe(el));
      }

      // Header shadow once the page has scrolled off the top.
      const head = document.querySelector(".site-head");
      const bar = document.getElementById("progress");

      const onScroll = () => {
        head?.classList.toggle("scrolled", window.scrollY > 8);
        if (bar) {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
          bar.style.width = `${pct}%`;
        }
      };

      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    </script>

    <style>
      .progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 2px;
        width: 0;
        background: var(--accent);
        z-index: 120;
      }

      .site-head {
        position: sticky;
        top: 0;
        z-index: 100;
        background: color-mix(in srgb, var(--paper) 88%, transparent);
        backdrop-filter: saturate(180%) blur(10px);
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s ease;
      }

      .site-head.scrolled {
        border-bottom-color: var(--rule);
      }

      .head-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        min-height: 4.25rem;
      }

      .wordmark {
        text-decoration: none;
        display: flex;
        align-items: baseline;
        gap: 0.7rem;
        min-width: 0;
      }

      .wordmark-name {
        font-weight: 600;
        letter-spacing: -0.02em;
        font-size: 1rem;
        white-space: nowrap;
      }

      .wordmark-sub {
        font-size: var(--fs-label);
        white-space: nowrap;
      }

      .site-nav {
        display: flex;
        align-items: center;
        gap: clamp(0.85rem, 2vw, 1.7rem);
      }

      .nav-link {
        text-decoration: none;
        font-size: var(--fs-ui);
        color: var(--ink-2);
        position: relative;
        padding: 0.3rem 0;
        white-space: nowrap;
        transition: color 0.16s ease;
      }

      .nav-link:hover {
        color: var(--ink);
      }

      .nav-link.current {
        color: var(--ink);
      }

      .nav-link.current::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.1rem;
        height: 1px;
        background: var(--accent);
      }

      .site-foot {
        border-top: 1px solid var(--rule);
        margin-top: var(--step);
        padding-block: 3rem 3.5rem;
        background: var(--paper-2);
      }

      .foot-inner {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 2.5rem;
        font-size: var(--fs-ui);
      }

      .foot-inner .mono {
        margin-bottom: 0.75rem;
      }

      .foot-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.32rem;
      }

      .foot-end {
        align-self: start;
      }

      .foot-fine {
        font-size: var(--fs-sm);
        margin-top: 0.6rem;
      }

      @media (max-width: 720px) {
        .wordmark-sub {
          display: none;
        }

        .head-inner {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.35rem;
          padding-block: 0.7rem;
          /* The nav scrolls edge to edge; the gutter is re-added inside it. */
          padding-inline: 0;
        }

        .wordmark {
          padding-inline: var(--gutter);
        }

        .site-nav {
          width: 100%;
          overflow-x: auto;
          scrollbar-width: none;
          padding-bottom: 0.15rem;
          /* Trailing gutter so the last control clears the screen edge. */
          padding-inline: var(--gutter);
          gap: 1rem;
        }

        .site-nav::-webkit-scrollbar {
          display: none;
        }

        /* Five links plus the toggle overflow a 375px screen, so the toggle
           moves up to the wordmark row. The sticky header is its containing
           block. */
        .site-nav :global(.theme-toggle) {
          position: absolute;
          top: 0.55rem;
          right: var(--gutter);
        }
      }
    </style>
  </body>
</html>
